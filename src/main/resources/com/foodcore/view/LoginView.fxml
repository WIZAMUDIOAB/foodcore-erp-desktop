<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.foodcore.controller.LoginController"
           prefHeight="680.0" prefWidth="1000.0" style="-fx-background-color: #0c0e12;">

    <!-- Card Contenedor Dividido (Split Studio Card) -->
    <HBox maxWidth="860.0" maxHeight="520.0"
          style="-fx-background-color: #ffffff; -fx-background-radius: 14px; -fx-effect: dropshadow(gaussian, rgba(0,0,0,0.45), 24, 0, 0, 8);">

        <!-- Panel Izquierdo: Branding & Contexto Operativo -->
        <VBox prefWidth="380.0" spacing="16.0"
              style="-fx-background-color: #11141a; -fx-background-radius: 14px 0 0 14px; -fx-padding: 40px 32px;">

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Label text="FoodCore" style="-fx-text-fill: #ffffff; -fx-font-weight: 800; -fx-font-size: 20px; -fx-letter-spacing: -0.02em;"/>
                <Label text="PRO" style="-fx-background-color: rgba(217, 78, 52, 0.2); -fx-text-fill: #f26a50; -fx-font-size: 10px; -fx-font-weight: bold; -fx-padding: 2px 7px; -fx-background-radius: 999px;"/>
            </HBox>

            <VBox spacing="4.0">
                <Label text="Fast Food S.A.C." style="-fx-text-fill: #f3f4f6; -fx-font-weight: 700; -fx-font-size: 14px;"/>
                <Label text="Sistema integral de punto de venta, comandería y gestión de salón."
                       wrapText="true" style="-fx-text-fill: #8c96a5; -fx-font-size: 12px; -fx-line-spacing: 2px;"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Badge de Base de Datos -->
            <VBox spacing="6.0" style="-fx-background-color: #171c24; -fx-padding: 14px; -fx-background-radius: 8px; -fx-border-color: #242c38; -fx-border-radius: 8px;">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label style="-fx-background-color: #10b981; -fx-min-width: 8px; -fx-min-height: 8px; -fx-background-radius: 4px;"/>
                    <Label text="MySQL 8.0 LAN · Activo" style="-fx-text-fill: #f9fafb; -fx-font-weight: 700; -fx-font-size: 11px;"/>
                </HBox>
                <Label text="Puerto 3306 · 23 tablas InnoDB sincronizadas" style="-fx-text-fill: #6b7280; -fx-font-size: 10px;"/>
            </VBox>

            <!-- Cuentas de Acceso Rapido -->
            <VBox spacing="3.0">
                <Label text="CUENTAS DEMO:" style="-fx-text-fill: #4b5563; -fx-font-size: 10px; -fx-font-weight: 700; -fx-letter-spacing: 0.05em;"/>
                <Label text="admin / cajero / mozo / cocinero (pass: *123)" style="-fx-text-fill: #8c96a5; -fx-font-size: 10px;"/>
            </VBox>
        </VBox>

        <!-- Panel Derecho: Formulario de Autenticacion -->
        <VBox HBox.hgrow="ALWAYS" spacing="18.0" style="-fx-padding: 40px 38px; -fx-background-color: #ffffff; -fx-background-radius: 0 14px 14px 0;">

            <VBox spacing="2.0">
                <Label text="Iniciar Sesión" style="-fx-font-size: 20px; -fx-font-weight: 800; -fx-text-fill: -color-ink-primary; -fx-letter-spacing: -0.015em;"/>
                <Label text="Ingrese sus credenciales para acceder al terminal" style="-fx-text-fill: -color-ink-secondary; -fx-font-size: 12px;"/>
            </VBox>

            <!-- Inputs -->
            <VBox spacing="6.0">
                <Label text="Usuario" style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: -color-ink-primary;"/>
                <TextField fx:id="txtUsername" promptText="ej: admin, mozo" prefHeight="42.0"/>
            </VBox>

            <VBox spacing="6.0">
                <Label text="Contraseña" style="-fx-font-weight: 700; -fx-font-size: 12px; -fx-text-fill: -color-ink-primary;"/>
                <PasswordField fx:id="txtPassword" promptText="••••••••" prefHeight="42.0"/>
            </VBox>

            <Label fx:id="lblMensaje" textFill="#dc2626" wrapText="true" visible="false"
                   style="-fx-font-size: 12px; -fx-font-weight: 600;"/>

            <!-- Boton de Ingreso -->
            <Button fx:id="btnLogin" text="Ingresar al Terminal" onAction="#handleLogin"
                    maxWidth="Infinity" prefHeight="44.0" styleClass="btn-primary"/>

            <Region VBox.vgrow="ALWAYS"/>

            <!-- Acceso Directo a Marcacion de Asistencia -->
            <HBox alignment="CENTER">
                <Button text="Reloj de Marcación de Asistencia (DNI) →" onAction="#handleAbrirAsistencia"
                        style="-fx-background-color: transparent; -fx-text-fill: -color-ink-secondary; -fx-font-size: 12px; -fx-font-weight: 600; -fx-cursor: hand;"/>
            </HBox>
        </VBox>
    </HBox>

</StackPane>
