<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<StackPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.foodcore.controller.LoginController"
           prefHeight="650.0" prefWidth="950.0" style="-fx-background-color: #f4f6f8;">

    <VBox alignment="CENTER" maxWidth="420.0" spacing="20.0"
          style="-fx-background-color: white; -fx-background-radius: 12px; -fx-padding: 35px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 15, 0, 0, 5);">
        
        <VBox alignment="CENTER" spacing="5.0">
            <Label text="FOODCORE ERP" styleClass="brand-title">
                <font>
                    <Font name="System Bold" size="24.0"/>
                </font>
            </Label>
            <Label text="Restaurante Fast Food S.A.C." styleClass="brand-subtitle"/>
        </VBox>

        <Separator/>

        <VBox alignment="CENTER_LEFT" spacing="6.0">
            <Label text="Usuario:" style="-fx-font-weight: bold;"/>
            <TextField fx:id="txtUsername" promptText="Ingrese su usuario (ej: admin, mozo1)" prefHeight="38.0" styleClass="text-field"/>
        </VBox>

        <VBox alignment="CENTER_LEFT" spacing="6.0">
            <Label text="Contraseña:" style="-fx-font-weight: bold;"/>
            <PasswordField fx:id="txtPassword" promptText="••••••••" prefHeight="38.0" styleClass="password-field"/>
        </VBox>

        <Label fx:id="lblMensaje" textFill="#e63946" wrapText="true" visible="false"/>

        <Button fx:id="btnLogin" text="INICIAR SESIÓN" onAction="#handleLogin"
                maxWidth="Infinity" prefHeight="42.0"
                style="-fx-background-color: #1d3557; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand; -fx-background-radius: 6px;"/>

        <HBox alignment="CENTER" spacing="10.0">
            <Button text="Marcación Rápida de Asistencia (DNI)" onAction="#handleAbrirAsistencia"
                    style="-fx-background-color: transparent; -fx-text-fill: #457b9d; -fx-underline: true; -fx-cursor: hand;"/>
        </HBox>

        <VBox alignment="CENTER" spacing="2.0">
            <Label text="Usuarios semilla: admin / mozo1 / cocina1 / gerente" style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
            <Label text="Contraseña por defecto: admin123 / mozo123 / cocina123" style="-fx-font-size: 11px; -fx-text-fill: #adb5bd;"/>
        </VBox>
    </VBox>

</StackPane>
