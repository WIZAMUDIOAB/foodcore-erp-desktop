<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootAuditoriaStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.AuditoriaController">
    <padding>
        <Insets bottom="20.0" left="24.0" right="24.0" top="20.0" />
    </padding>
    <children>
        <!-- Panel principal estilo .card (Sub-Fase E - E1) -->
        <VBox fx:id="boxContenedorPrincipal" spacing="16.0" styleClass="card">
            <children>
                <VBox fx:id="boxContenidoAuditoria" spacing="16.0" VBox.vgrow="ALWAYS">
                    <children>
                        <!-- Cabecera y Exportación -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Bitácora de Auditoría y Trazabilidad (Audit Trail)" />
                                                <Label styleClass="badge-pill-danger" text="SOLO ADMIN" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Consulta filtrada, paginada (50 registros) y exportable de eventos críticos de seguridad, ventas y operaciones" />
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnExportarPdf" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleExportarPdf" styleClass="btn-secondary" text="Exportar PDF">
                                            <graphic>
                                                <FontIcon iconLiteral="fth-file-text" iconSize="14" />
                                            </graphic>
                                        </Button>
                                        <Button fx:id="btnExportarExcel" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleExportarExcel" styleClass="btn-secondary" text="Exportar Excel">
                                            <graphic>
                                                <FontIcon iconLiteral="fth-grid" iconSize="14" />
                                            </graphic>
                                        </Button>
                                        <Button fx:id="btnExportarCsv" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleExportarCsv" styleClass="btn-secondary" text="Exportar CSV">
                                            <graphic>
                                                <FontIcon iconLiteral="fth-download" iconSize="14" />
                                            </graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <Region styleClass="divider-horizontal" />

                        <!-- Barra Superior de Filtros con Labels Estáticos (v2.2) -->
                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                            <children>
                                <VBox prefWidth="210.0" spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Usuario" />
                                        <ComboBox fx:id="cmbFiltroMozo" maxWidth="1.7976931348623157E308" promptText="Todos los Usuarios" styleClass="form-combo-box" />
                                    </children>
                                </VBox>
                                <VBox prefWidth="200.0" spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Acción" />
                                        <ComboBox fx:id="cmbFiltroAccion" maxWidth="1.7976931348623157E308" promptText="Todas las Acciones" styleClass="form-combo-box" />
                                    </children>
                                </VBox>
                                <VBox prefWidth="150.0" spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Desde" />
                                        <DatePicker fx:id="dpDesde" maxWidth="1.7976931348623157E308" promptText="Fecha inicial" styleClass="form-date-picker" />
                                    </children>
                                </VBox>
                                <VBox prefWidth="150.0" spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Hasta" />
                                        <DatePicker fx:id="dpHasta" maxWidth="1.7976931348623157E308" promptText="Fecha final" styleClass="form-date-picker" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnFiltrarAuditoria" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleFiltrarAuditoria" styleClass="btn-primary" text="Filtrar">
                                    <graphic>
                                        <FontIcon iconLiteral="fth-filter" iconSize="14" />
                                    </graphic>
                                </Button>
                                <Button fx:id="btnLimpiarFiltros" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleLimpiarFiltros" styleClass="btn-secondary" text="Limpiar">
                                    <graphic>
                                        <FontIcon iconLiteral="fth-refresh-cw" iconSize="14" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Tabla de Eventos de Auditoría con EmptyStateHelper -->
                        <StackPane VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tblAuditoria" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <VBox alignment="CENTER" spacing="12.0">
                                            <children>
                                                <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="text-muted" />
                                                <Label styleClass="h3" text="No hay registros de auditoría" />
                                                <Label styleClass="text-secondary" text="No se encontraron eventos para los filtros seleccionados." />
                                            </children>
                                        </VBox>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="colIdAuditoria" prefWidth="85.0" text="Audit ID" />
                                        <TableColumn fx:id="colFecha" prefWidth="155.0" text="Fecha y Hora" />
                                        <TableColumn fx:id="colUsuario" prefWidth="135.0" text="Usuario Responsable" />
                                        <TableColumn fx:id="colAccion" prefWidth="150.0" text="Acción Ejecutada" />
                                        <TableColumn fx:id="colEntidad" prefWidth="120.0" text="Entidad Afectada" />
                                        <TableColumn fx:id="colDatosAnteriores" prefWidth="200.0" text="Datos Anteriores" />
                                        <TableColumn fx:id="colDatosNuevos" prefWidth="210.0" text="Datos Nuevos / Motivo" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                                <VBox fx:id="emptyState" alignment="CENTER" mouseTransparent="true" spacing="12.0" visible="false">
                                    <children>
                                        <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="text-muted" />
                                        <Label styleClass="h3" text="No hay registros de auditoría" />
                                        <Label styleClass="text-secondary" text="No se encontraron eventos para los filtros seleccionados." />
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>

                        <!-- Pie de Paginación (50 registros/página) y Estado de Exportación -->
                        <HBox fx:id="boxPaginacion" alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label fx:id="lblPaginacionInfo" styleClass="text-secondary" text="Página 1 de 1 · 0 registros (50 por página)" />
                                <Label fx:id="lblEstadoExportacion" styleClass="badge-pill-neutral" text="Listo" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnPaginaAnterior" disable="true" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handlePaginaAnterior" styleClass="btn-secondary" text="Anterior">
                                    <graphic>
                                        <FontIcon iconLiteral="fth-chevron-left" iconSize="14" />
                                    </graphic>
                                </Button>
                                <Button fx:id="btnPaginaSiguiente" disable="true" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handlePaginaSiguiente" styleClass="btn-secondary" text="Siguiente">
                                    <graphic>
                                        <FontIcon iconLiteral="fth-chevron-right" iconSize="14" />
                                    </graphic>
                                </Button>
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- Banner Acceso Restringido para roles no ADMIN -->
                <VBox fx:id="boxAccesoRestringido" alignment="CENTER" managed="false" spacing="12.0" visible="false" VBox.vgrow="ALWAYS">
                    <children>
                        <FontIcon iconLiteral="fth-shield" iconSize="48" styleClass="text-muted" />
                        <Label styleClass="h2" text="Acceso Restringido a Auditoría" />
                        <Label styleClass="text-secondary" text="Solo los usuarios con rol ADMIN pueden consultar o exportar la bitácora de auditoría." />
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
