<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodcore.controller.MainDashboardController"
            prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: #f8f9fa;">

    <!-- Barra Lateral Izquierda de Navegación -->
    <left>
        <VBox prefWidth="250.0" spacing="10.0" style="-fx-background-color: #1d3557; -fx-padding: 20px 15px;">
            <VBox spacing="4.0">
                <Label text="FOODCORE ERP" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 20px;"/>
                <Label text="Fast Food S.A.C." style="-fx-text-fill: #a8dadc; -fx-font-size: 12px;"/>
            </VBox>

            <Separator opacity="0.3"/>

            <Label text="MÓDULOS DEL SISTEMA" style="-fx-text-fill: #8d99ae; -fx-font-size: 11px; -fx-font-weight: bold;"/>

            <Button fx:id="btnNavPOS" text="1. Punto de Venta (POS)" onAction="#handleNavPOS"
                    maxWidth="Infinity" prefHeight="40.0" alignment="BASELINE_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Button fx:id="btnNavSalon" text="2. Salón y Mesas (Mozo)" onAction="#handleNavSalon"
                    maxWidth="Infinity" prefHeight="40.0" alignment="BASELINE_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Button fx:id="btnNavKDS" text="3. Monitor Cocina (KDS)" onAction="#handleNavKDS"
                    maxWidth="Infinity" prefHeight="40.0" alignment="BASELINE_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Button fx:id="btnNavReportes" text="4. Reportes Gerenciales" onAction="#handleNavReportes"
                    maxWidth="Infinity" prefHeight="40.0" alignment="BASELINE_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Button fx:id="btnNavAsistencia" text="5. Control de Asistencia" onAction="#handleNavAsistencia"
                    maxWidth="Infinity" prefHeight="40.0" alignment="BASELINE_LEFT"
                    style="-fx-background-color: transparent; -fx-text-fill: white; -fx-font-size: 13px; -fx-cursor: hand;"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator opacity="0.3"/>

            <VBox spacing="6.0">
                <Label fx:id="lblUsuarioLogueado" text="Usuario: Administrador" style="-fx-text-fill: #f1faee; -fx-font-size: 12px; -fx-font-weight: bold;"/>
                <Button text="Cerrar Sesión" onAction="#handleCerrarSesion" maxWidth="Infinity"
                        style="-fx-background-color: #e63946; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Contenedor Central Dinámico -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: #ffffff;"/>
    </center>

</BorderPane>
