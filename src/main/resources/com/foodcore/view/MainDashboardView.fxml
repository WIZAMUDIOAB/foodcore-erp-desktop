<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodcore.controller.MainDashboardController"
            prefHeight="750.0" prefWidth="1200.0" style="-fx-background-color: -color-bg-base;">

    <!-- Barra Lateral Izquierda de Navegacion (Command Rail) -->
    <left>
        <VBox prefWidth="255.0" spacing="6.0" styleClass="sidebar-container" style="-fx-padding: 22px 14px;">
            <!-- Brand & Identity -->
            <VBox spacing="4.0" style="-fx-padding: 0 8px 14px 8px;">
                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="FoodCore" styleClass="sidebar-brand-title"/>
                    <Label text="PRO" styleClass="sidebar-brand-badge"/>
                </HBox>
                <Label text="Fast Food S.A.C. · Terminal LAN" style="-fx-text-fill: #6b7280; -fx-font-size: 11px;"/>
            </VBox>

            <Separator style="-fx-opacity: 0.12;"/>

            <!-- Seccion de Operaciones -->
            <Label text="OPERACIONES Y VENTAS" styleClass="sidebar-section-header"/>

            <Button fx:id="btnNavPOS" text="Punto de Venta" onAction="#handleNavPOS"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <Button fx:id="btnNavSalon" text="Salón y Mesas" onAction="#handleNavSalon"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <Button fx:id="btnNavKDS" text="Línea de Cocina (KDS)" onAction="#handleNavKDS"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <!-- Seccion de Gestion y Auditoria -->
            <Label text="GESTIÓN Y RECURSOS" styleClass="sidebar-section-header"/>

            <Button fx:id="btnNavReportes" text="Analítica y Reportes" onAction="#handleNavReportes"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <Button fx:id="btnNavAsistencia" text="Reloj de Asistencia" onAction="#handleNavAsistencia"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <Button fx:id="btnNavMantenimiento" text="Base de Datos y Stock" onAction="#handleNavMantenimiento"
                    maxWidth="Infinity" prefHeight="42.0" styleClass="sidebar-nav-button"/>

            <Region VBox.vgrow="ALWAYS"/>

            <Separator style="-fx-opacity: 0.12;"/>

            <!-- Perfil de Sesion Activa -->
            <VBox spacing="8.0" style="-fx-padding: 6px 4px 0 4px;">
                <HBox alignment="CENTER_LEFT" spacing="10.0"
                      style="-fx-background-color: #161920; -fx-padding: 10px; -fx-background-radius: 8px;">
                    <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                        <Label fx:id="lblUsuarioLogueado" text="Administrador"
                               style="-fx-text-fill: #f9fafb; -fx-font-weight: 700; -fx-font-size: 12px;"/>
                        <Label text="Sesión autorizada" style="-fx-text-fill: #10b981; -fx-font-size: 10px;"/>
                    </VBox>
                </HBox>
                <Button text="Cerrar Sesión" onAction="#handleCerrarSesion" maxWidth="Infinity" prefHeight="32.0"
                        style="-fx-background-color: transparent; -fx-text-fill: #9ca3af; -fx-font-size: 11px; -fx-cursor: hand; -fx-border-color: #272c36; -fx-border-radius: 6px;"/>
            </VBox>
        </VBox>
    </left>

    <!-- Contenedor Central Dinamico -->
    <center>
        <StackPane fx:id="contentArea" style="-fx-background-color: -color-bg-base;"/>
    </center>

</BorderPane>
