<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootHistorialVentasStack" prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.HistorialVentasController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="980.0" styleClass="pos-catalog-panel">
                    <top>
                        <VBox minHeight="118.0" spacing="12.0" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="view-heading" text="Historial de Ventas y Devoluciones Parciales" />
                                                        <Label styleClass="badge-pill-accent" text="POS v5.2" />
                                                    </children>
                                                </HBox>
                                                <Label styleClass="view-subheading" text="Busque comprobantes cobrados, seleccione ítems específicos y ejecute devoluciones parciales con reverso Kárdex y egreso en Caja" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Region styleClass="divider-horizontal" />

                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="text-body-strong" text="Desde:" />
                                        <DatePicker fx:id="dpDesde" prefWidth="140.0" styleClass="form-date-picker" />
                                        <Label styleClass="text-body-strong" text="Hasta:" />
                                        <DatePicker fx:id="dpHasta" prefWidth="140.0" styleClass="form-date-picker" />
                                        <TextField fx:id="txtBuscarVenta" promptText="Buscar por # venta, mesa, cliente o método..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnBuscarHistorial" mnemonicParsing="false" onAction="#handleBuscarVentas" styleClass="btn-primary" text="Buscar Ventas" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </top>

                    <center>
                        <HBox spacing="16.0" styleClass="kardex-table-wrapper" BorderPane.alignment="CENTER">
                            <children>
                                <VBox spacing="8.0" styleClass="surface-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="text-h2" text="Tickets / Ventas Registradas" />
                                        <TableView fx:id="tblVentas" minHeight="420.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colVentaId" prefWidth="72.0" text="# Venta" />
                                                <TableColumn fx:id="colVentaFecha" prefWidth="122.0" text="Fecha / Hora" />
                                                <TableColumn fx:id="colVentaMesa" prefWidth="95.0" text="Mesa" />
                                                <TableColumn fx:id="colVentaMetodo" prefWidth="78.0" text="Pago" />
                                                <TableColumn fx:id="colVentaTotal" prefWidth="84.0" text="Total" />
                                                <TableColumn fx:id="colVentaEstado" prefWidth="150.0" text="Estado" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <VBox prefWidth="495.0" spacing="12.0" styleClass="surface-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label fx:id="lblVentaSeleccionada" styleClass="text-h2" text="Seleccione una venta" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="text-caption" text="Marque los platillos o ítems a devolver de forma parcial:" />

                                        <TableView fx:id="tblDetallesVenta" minHeight="290.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colDetSeleccion" prefWidth="48.0" text="Sel." />
                                                <TableColumn fx:id="colDetProducto" prefWidth="175.0" text="Producto" />
                                                <TableColumn fx:id="colDetCant" prefWidth="52.0" text="Cant." />
                                                <TableColumn fx:id="colDetSubtotal" prefWidth="92.0" text="Subtotal" />
                                                <TableColumn fx:id="colDetEstado" prefWidth="88.0" text="Estado" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>

                                        <TextField fx:id="txtMotivoDevolucion" promptText="Motivo de devolución (ej. Plato no entregado / cambio)" styleClass="input-field" />

                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label fx:id="lblTotalReembolso" styleClass="text-body-strong" text="Reembolso seleccionado: S/ 0.00" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnDevolucionParcial" mnemonicParsing="false" onAction="#handleDevolucionParcial" styleClass="btn-destructive" text="Devolución Parcial" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </center>
                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
