<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodcore.controller.ComandaCardController"
      fx:id="cardContainer" prefWidth="290.0" spacing="8.0"
      style="-fx-background-color: white; -fx-background-radius: 8px; -fx-padding: 12px; -fx-border-color: #2a9d8f; -fx-border-width: 3px; -fx-border-radius: 8px; -fx-effect: dropshadow(three-pass-box, rgba(0,0,0,0.1), 5, 0, 0, 2);">

    <!-- Encabezado de Tarjeta -->
    <HBox alignment="CENTER_LEFT" spacing="8.0">
        <Label fx:id="lblNumeroMesa" text="MESA 04" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Label fx:id="lblTiempo" text="00:00 min" style="-fx-font-weight: bold; -fx-text-fill: #2a9d8f; -fx-font-size: 13px;"/>
    </HBox>

    <Label fx:id="lblNumeroComanda" text="Comanda #COM-0012" style="-fx-font-size: 12px; -fx-text-fill: #6c757d;"/>

    <Separator/>

    <!-- Lista de Platos a Preparar con Notas -->
    <VBox fx:id="vboxItems" spacing="6.0" minHeight="120.0"/>

    <Separator/>

    <!-- Estado y Botones de Acción -->
    <Label fx:id="lblEstado" text="Estado: PENDIENTE" style="-fx-font-weight: bold; -fx-font-size: 12px;"/>

    <HBox spacing="8.0">
        <Button fx:id="btnIniciar" text="Iniciar" onAction="#handleIniciar" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color: #e9c46a; -fx-text-fill: #1d3557; -fx-font-weight: bold; -fx-cursor: hand;"/>
        <Button fx:id="btnDespachar" text="Listo / Despachar" onAction="#handleDespachar" HBox.hgrow="ALWAYS" maxWidth="Infinity"
                style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
    </HBox>

</VBox>
