<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootMiHorarioStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.MiHorarioController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
                    <!-- Encabezado Personal -->
                    <top>
                        <VBox spacing="14.0">
                            <padding>
                                <Insets bottom="12.0" left="24.0" right="24.0" top="24.0" />
                            </padding>
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label styleClass="view-heading" text="Mi Portal del Colaborador" />
                                                        <Label fx:id="lblMiRolBadge" styleClass="badge-pill-accent" text="MOZO" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblBienvenida" styleClass="view-subheading" text="Bienvenido, consulte sus turnos asignados de la semana, asistencias y boletas de pago" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Resumen Mensual Personal (v4.6.0 Fase 3 KPI Cards) -->
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="text-overline" text="HORAS ACUMULADAS MES" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <StackPane styleClass="kpi-icon-circle-blue">
                                                            <children>
                                                                <FontIcon iconColor="#2563EB" iconLiteral="fas-clock" iconSize="16" />
                                                            </children>
                                                        </StackPane>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblMisHorasMes" styleClass="kpi-value-24-blue" text="0.0 hrs" />
                                                <Label styleClass="kpi-subtitle-muted" text="Jornadas efectivas completadas" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="text-overline" text="DÍAS ASISTIDOS" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <StackPane styleClass="kpi-icon-circle-success">
                                                            <children>
                                                                <FontIcon iconColor="#059669" iconLiteral="fas-calendar-check" iconSize="16" />
                                                            </children>
                                                        </StackPane>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblMisDiasTrabajados" styleClass="kpi-value-24-success" text="0" />
                                                <Label styleClass="kpi-subtitle-muted" text="Turnos asistidos este mes" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="text-overline" text="TARDANZAS ACUMULADAS" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <StackPane styleClass="kpi-icon-circle-amber">
                                                            <children>
                                                                <FontIcon iconColor="#D97706" iconLiteral="fas-exclamation-triangle" iconSize="16" />
                                                            </children>
                                                        </StackPane>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblMisTardanzasMin" styleClass="kpi-value-24-amber" text="0 min" />
                                                <Label styleClass="kpi-subtitle-muted" text="Tolerancia legal: 5 min" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="text-overline" text="SUELDO BASE ASIGNADO" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <StackPane styleClass="kpi-icon-circle-accent">
                                                            <children>
                                                                <FontIcon iconColor="#F05A22" iconLiteral="fas-wallet" iconSize="16" />
                                                            </children>
                                                        </StackPane>
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblMiSueldoBase" styleClass="kpi-value-24-accent" text="S/ 0.00" />
                                                <Label styleClass="kpi-subtitle-muted" text="Planilla mensual regular" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </top>

                    <!-- Portal de 3 Pestañas: Mi Horario | Mis Asistencias | Mis Boletas (v4.4.0 §4) -->
                    <center>
                        <VBox spacing="12.0">
                            <padding>
                                <Insets bottom="24.0" left="24.0" right="24.0" top="4.0" />
                            </padding>
                            <children>
                                <TabPane fx:id="tabPaneMiPortal" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                    <tabs>
                                        <!-- TAB 1: MI HORARIO -->
                                        <Tab fx:id="tabMiHorario" text="Mi Horario">
                                            <content>
                                                <VBox spacing="14.0" style="-fx-padding: 14 0 0 0;">
                                                    <children>
                                                        <VBox spacing="10.0" styleClass="surface-card">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label styleClass="text-h3" text="Cronograma Semanal de Turnos Asignados" />
                                                                        <Region HBox.hgrow="ALWAYS" />
                                                                        <Label styleClass="badge-pill-success" text="PUBLICADO" />
                                                                    </children>
                                                                </HBox>
                                                                <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="NEVER">
                                                                    <content>
                                                                        <HBox fx:id="boxDiasSemana" spacing="8.0" />
                                                                    </content>
                                                                </ScrollPane>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>

                                        <!-- TAB 2: MIS ASISTENCIAS -->
                                        <Tab fx:id="tabMisAsistencias" text="Mis Asistencias">
                                            <content>
                                                <VBox spacing="12.0" style="-fx-padding: 14 0 0 0;">
                                                    <children>
                                                        <VBox spacing="10.0" styleClass="surface-card" VBox.vgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                                    <children>
                                                                        <Label styleClass="text-h3" text="Historial de Asistencias y Marcajes Recientes" />
                                                                        <Region HBox.hgrow="ALWAYS" />
                                                                        <Label styleClass="badge-pill-neutral" text="RELOJ BIOMÉTRICO / PIN" />
                                                                    </children>
                                                                </HBox>
                                                                <TableView fx:id="tblMisAsistencias" minHeight="320.0" VBox.vgrow="ALWAYS">
                                                                    <columns>
                                                                        <TableColumn fx:id="colFecha" prefWidth="110.0" text="Fecha" />
                                                                        <TableColumn fx:id="colDia" prefWidth="95.0" text="Día" />
                                                                        <TableColumn fx:id="colEntrada" prefWidth="105.0" text="Hora Entrada" />
                                                                        <TableColumn fx:id="colSalida" prefWidth="105.0" text="Hora Salida" />
                                                                        <TableColumn fx:id="colHoras" prefWidth="95.0" text="Total Horas" />
                                                                        <TableColumn fx:id="colExtra" prefWidth="95.0" text="H. Extra" />
                                                                        <TableColumn fx:id="colTardanza" prefWidth="95.0" text="Tardanza" />
                                                                        <TableColumn fx:id="colEstado" prefWidth="105.0" text="Estado" />
                                                                        <TableColumn fx:id="colNotas" prefWidth="120.0" text="Observaciones" />
                                                                    </columns>
                                                                    <columnResizePolicy>
                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                    </columnResizePolicy>
                                                                </TableView>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>

                                        <!-- TAB 3: MIS BOLETAS DE PAGO -->
                                        <Tab fx:id="tabMisBoletas" text="Mis Boletas">
                                            <content>
                                                <VBox spacing="12.0" style="-fx-padding: 14 0 0 0;">
                                                    <children>
                                                        <VBox spacing="12.0" styleClass="surface-card" VBox.vgrow="ALWAYS">
                                                            <children>
                                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                                    <children>
                                                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                                                            <children>
                                                                                <Label styleClass="text-h3" text="Boletas de Remuneración Mensual" />
                                                                                <Label fx:id="lblEstadoBoleta" styleClass="text-caption" text="Seleccione un período para descargar su boleta oficial en PDF" />
                                                                            </children>
                                                                        </VBox>
                                                                        <Button fx:id="btnDescargarBoletaPdf" mnemonicParsing="false" onAction="#handleDescargarBoletaPdf" styleClass="btn-primary" text="📄 Descargar Boleta (PDF)" />
                                                                    </children>
                                                                </HBox>
                                                                <TableView fx:id="tblMisBoletas" minHeight="310.0" VBox.vgrow="ALWAYS">
                                                                    <columns>
                                                                        <TableColumn fx:id="colBoletaPeriodo" prefWidth="140.0" text="Período" />
                                                                        <TableColumn fx:id="colBoletaSueldoBase" prefWidth="130.0" text="Sueldo Base" />
                                                                        <TableColumn fx:id="colBoletaBonos" prefWidth="130.0" text="Horas Extra / Bonos" />
                                                                        <TableColumn fx:id="colBoletaDescuentos" prefWidth="130.0" text="Aportes ONP/AFP" />
                                                                        <TableColumn fx:id="colBoletaNeto" prefWidth="130.0" text="Neto a Pagar" />
                                                                        <TableColumn fx:id="colBoletaEstado" prefWidth="110.0" text="Estado" />
                                                                        <TableColumn fx:id="colBoletaAccion" prefWidth="115.0" text="Comprobante" />
                                                                    </columns>
                                                                    <columnResizePolicy>
                                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                                    </columnResizePolicy>
                                                                </TableView>
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </children>
                        </VBox>
                    </center>
                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
