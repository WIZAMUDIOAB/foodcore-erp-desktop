<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.VentaController">

    <!-- Topbar Superior -->
    <top>
        <HBox alignment="CENTER_LEFT" minHeight="64.0" prefHeight="64.0" spacing="12.0" styleClass="view-topbar">
            <VBox spacing="2.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="view-heading" text="Terminal Punto de Venta (POS)" />
                    <Label styleClass="badge-pill-success" text="CAJA ACTIVA" />
                    <Label fx:id="lblAutoRefreshStatus" styleClass="badge-pill-neutral" text="AUTO-SYNC 5s" />
                </HBox>
                <Label styleClass="view-subheading" text="Facturación multicanal (Salón 12 Mesas, Kiosco, Delivery), envío a cocina y cobro multimedio" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button fx:id="btnFidelizacion" mnemonicParsing="false" onAction="#handleFidelizacionCanje" styleClass="btn-secondary" text="🎁 Fidelización" />
                <Button fx:id="btnDividirCuenta" mnemonicParsing="false" onAction="#handleDividirCuenta" styleClass="btn-secondary" text="Dividir Cuenta" />
                <Button fx:id="btnDescuento" mnemonicParsing="false" onAction="#handleAplicarDescuento" styleClass="btn-secondary" text="Descuento" />
                <Button fx:id="btnAnularVenta" mnemonicParsing="false" onAction="#handleAnularVenta" styleClass="btn-secondary" text="Anular Venta" />
                <Button mnemonicParsing="false" onAction="#handleAbrirArqueo" styleClass="btn-secondary" text="Arqueo y Cierre" />
            </HBox>
        </HBox>
    </top>

    <!-- Centro: Split 35% Orden (Izquierda) / 65% Catálogo & Mesas Multicanal (Derecha) (§6 & v4.4.0 §2) -->
    <center>
        <GridPane fx:id="posSplitGrid">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="35.0" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="65.0" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>
            <children>

                <!-- PANEL IZQUIERDO (35% ORDEN): Header con mesa/canal y mozo, pedidos activos rápidos, lista de ítems, totales mono, botones 56px -->
                <VBox spacing="6.0" style="-fx-padding: 10px 14px;" styleClass="pos-order-panel" GridPane.columnIndex="0">
                    <children>
                        <!-- Header Orden: Mesa, Badge Canal y Mozo -->
                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                            <children>
                                <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblOrdenHeader" styleClass="text-h2" text="Mesa 01 · Salón" />
                                                <Label fx:id="lblCanalBadge" minWidth="-Infinity" styleClass="badge-canal-mesa" text="[MESA 01]" />
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblMozoHeader" styleClass="text-caption" text="Mozo: Carlos Mendoza · Terminal POS-01" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnVerMesasPos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleMostrarTabMesas" style="-fx-padding: 5px 10px; -fx-font-size: 12px;" styleClass="category-chip" text="Mesas" />
                                <Button fx:id="btnNotaItem" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleNotaItem" style="-fx-padding: 5px 10px; -fx-font-size: 12px;" styleClass="category-chip" text="+ Nota" />
                                <Button fx:id="btnQuitarItem" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleEliminarItem" style="-fx-padding: 5px 10px; -fx-font-size: 12px;" styleClass="category-chip" text="Quitar" />
                            </children>
                        </HBox>

                        <!-- Barra rápida de pedidos activos entrantes (Salón / Kiosco / Delivery) -->
                        <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" prefHeight="28.0" vbarPolicy="NEVER">
                            <content>
                                <HBox fx:id="boxOrdenesEntrantes" alignment="CENTER_LEFT" spacing="6.0" />
                            </content>
                        </ScrollPane>

                        <!-- Lista de ítems de la orden -->
                        <TableView fx:id="tblDetalle" minHeight="115.0" prefHeight="155.0" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colProducto" minWidth="128.0" prefWidth="154.0" text="Ítem" />
                                <TableColumn fx:id="colCantidad" minWidth="58.0" prefWidth="60.0" text="Cant." />
                                <TableColumn fx:id="colPrecio" minWidth="74.0" prefWidth="76.0" text="P. Unit" />
                                <TableColumn fx:id="colSubtotal" minWidth="78.0" prefWidth="82.0" text="Importe" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>

                        <!-- CRM Minorista y Fidelización POS (SPEC v5.0.0) -->
                        <VBox fx:id="boxClienteFidelizacionPos" spacing="5.0" style="-fx-padding: 7px 10px;" styleClass="surface-card-subtle">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="6.0">
                                    <children>
                                        <TextField fx:id="txtBuscarClientePos" onAction="#handleBuscarClientePos" promptText="DNI o Teléfono..." style="-fx-padding: 6px 10px;" styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnBuscarClientePos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleBuscarClientePos" style="-fx-padding: 5px 10px; -fx-font-size: 12px;" styleClass="category-chip" text="Buscar" />
                                        <Button fx:id="btnNuevoClientePos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleRegistroRapidoClientePos" style="-fx-padding: 5px 10px; -fx-font-size: 12px;" styleClass="category-chip" text="+ DNI" />
                                        <Button fx:id="btnLimpiarClientePos" managed="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleLimpiarClientePos" style="-fx-padding: 5px 8px; -fx-font-size: 12px;" styleClass="category-chip" text="X" visible="false" />
                                    </children>
                                </HBox>
                                <HBox fx:id="rowClienteAsociadoPos" alignment="CENTER_LEFT" managed="false" spacing="6.0" visible="false">
                                    <children>
                                        <Label fx:id="lblClientePosNombre" maxWidth="1.7976931348623157E308" minWidth="0.0" styleClass="text-body-strong" text="Cliente asociado" HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblClientePosPuntos" minWidth="-Infinity" style="-fx-padding: 3px 9px;" styleClass="badge-pill-accent" text="0 pts" />
                                        <Button fx:id="btnCanjearPuntosPos" managed="false" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleCanjearPuntosPos" style="-fx-padding: 4px 10px; -fx-font-size: 11.5px; -fx-border-color: #F05A22; -fx-text-fill: #F05A22;" styleClass="category-chip" text="Canjear Puntos" visible="false" />
                                    </children>
                                </HBox>
                                <HBox fx:id="rowAlertaCumplePos" alignment="CENTER_LEFT" managed="false" spacing="6.0" visible="false">
                                    <children>
                                        <Label fx:id="lblAlertaCumplePos" maxWidth="1.7976931348623157E308" minWidth="0.0" style="-fx-padding: 4px 10px;" styleClass="badge-pill-success" text="Mes de Cumpleaños" HBox.hgrow="ALWAYS" />
                                        <Button fx:id="btnAplicarCumplePos" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAplicarCuponCumpleanosPos" style="-fx-padding: 4px 10px; -fx-font-size: 11.5px;" styleClass="category-chip" text="Aplicar 10%" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Totales fijos al fondo (Subtotal, IGV, Descuento, Total en Monoespaciado §2.2, §6, §3.2) -->
                        <VBox spacing="4.0" style="-fx-padding: 9px 12px;" styleClass="pos-totals-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="text-caption" text="Subtotal Gravado" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblSubtotal" styleClass="text-mono" text="S/ 0.00" />
                                    </children>
                                </HBox>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="text-caption" text="IGV (18%)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblIgv" styleClass="text-mono" text="S/ 0.00" />
                                    </children>
                                </HBox>
                                <HBox fx:id="rowDescuento" alignment="CENTER_LEFT" managed="false" visible="false">
                                    <children>
                                        <Label styleClass="text-caption" text="Descuento Autorizado" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblDescuento" styleClass="text-mono-accent" text="-S/ 0.00" />
                                    </children>
                                </HBox>
                                <HBox fx:id="rowDescuentoPuntos" alignment="CENTER_LEFT" managed="false" visible="false">
                                    <children>
                                        <Label fx:id="lblEtiquetaDescuentoPuntos" styleClass="text-caption" text="Canje Puntos (Sin IGV)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblDescuentoPuntos" styleClass="text-mono-accent" text="-S/ 0.00" />
                                    </children>
                                </HBox>
                                <Region styleClass="divider-horizontal" />
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="text-body-strong" text="Total a Pagar" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblTotal" styleClass="text-mono-lg-accent" text="S/ 0.00" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Botones primarios de orden: Enviar y Cobrar de 56px (§2.5 y §6) -->
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="btnEnviarCocina" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEnviarComanda" styleClass="btn-pos-action-secondary" text="Enviar" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnEfectivo" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCobroEfectivo" styleClass="btn-pos-action-primary" text="Cobrar" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <!-- Botones adicionales de medio de pago (56px) -->
                        <HBox spacing="10.0">
                            <children>
                                <Button fx:id="btnTarjeta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCobroTarjeta" styleClass="btn-pos-action-secondary" text="Cobrar Tarjeta" HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnYape" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCobroYape" styleClass="btn-pos-action-secondary" text="Cobrar Yape/Plin" HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <Button fx:id="btnPreCuenta" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleImprimirPreCuenta" prefHeight="36.0" style="-fx-min-height: 36px; -fx-pref-height: 36px; -fx-font-size: 13px;" styleClass="btn-secondary" text="Imprimir Pre-Cuenta" />

                        <!-- Footer del ticket con atajos visibles como chips (§6) -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="shortcut-chip" text="F5 Efectivo" />
                                <Label styleClass="shortcut-chip" text="F6 Tarjeta" />
                                <Label styleClass="shortcut-chip" text="F7 Yape/Plin" />
                            </children>
                        </HBox>
                    </children>
                </VBox>

                <!-- PANEL DERECHO (65%): TabPane con Catálogo de Platillos + Grid de 12 Mesas y Pedidos Multicanal -->
                <TabPane fx:id="tabPanePosCatalogo" tabClosingPolicy="UNAVAILABLE" GridPane.columnIndex="1">
                    <tabs>
                        <!-- Pestaña 1: Catálogo de Platillos -->
                        <Tab fx:id="tabCatalogo" text="🛒 Catálogo de Platillos">
                            <content>
                                <VBox spacing="16.0" styleClass="pos-catalog-panel">
                                    <children>
                                        <VBox spacing="12.0">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <TextField fx:id="txtBuscar" promptText="Buscar plato, bebida o código SKU..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                                                    </children>
                                                </HBox>
                                                <ScrollPane fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER">
                                                    <content>
                                                        <HBox fx:id="boxCategorias" alignment="CENTER_LEFT" spacing="8.0" />
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>

                                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                            <content>
                                                <TilePane fx:id="tileProductos" hgap="12.0" prefColumns="4" vgap="12.0" />
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>

                        <!-- Pestaña 2: Vista de 12 Mesas y Pedidos Multicanal (v4.4.0 §2) -->
                        <Tab fx:id="tabMesas" text="🪑 Mesas (12) y Pedidos Multicanal">
                            <content>
                                <VBox spacing="14.0" styleClass="pos-catalog-panel">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="text-h3" text="Salón Principal (12 Mesas) y Pedidos Multicanal" />
                                                <Label fx:id="lblResumenMesasPos" styleClass="badge-pill-accent" text="0 Ocupadas · 12 Libres" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnRefrescarMesasPos" mnemonicParsing="false" onAction="#handleRefrescarMesasPos" styleClass="btn-secondary" text="🔄 Actualizar" />
                                            </children>
                                        </HBox>

                                        <!-- Bandeja de pedidos activos KIOSCO y DELIVERY -->
                                        <VBox spacing="6.0" styleClass="stat-card">
                                            <children>
                                                <Label styleClass="stat-card-title" text="PEDIDOS KIOSCO Y DELIVERY ENTRANTES" />
                                                <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" prefHeight="68.0" vbarPolicy="NEVER">
                                                    <content>
                                                        <FlowPane fx:id="flowPedidosMulticanal" hgap="8.0" vgap="8.0" />
                                                    </content>
                                                </ScrollPane>
                                            </children>
                                        </VBox>

                                        <!-- Grid de 12 Mesas -->
                                        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                            <content>
                                                <TilePane fx:id="tileMesasPos" hgap="12.0" prefColumns="4" vgap="12.0" />
                                            </content>
                                        </ScrollPane>
                                    </children>
                                </VBox>
                            </content>
                        </Tab>
                    </tabs>
                </TabPane>

            </children>
        </GridPane>
    </center>

</BorderPane>
