<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodcore.controller.VentaController"
            prefHeight="720.0" prefWidth="1100.0" style="-fx-background-color: #f8f9fa;">

    <!-- Encabezado Superior -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="15.0" style="-fx-padding: 12px 20px; -fx-background-color: #1d3557;">
            <Label text="FOODCORE POS - TERMINAL DE VENTA TÁCTIL (IU06)" style="-fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 16px;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Arqueo / Cierre de Caja (IU13)" onAction="#handleAbrirArqueo"
                    style="-fx-background-color: #e63946; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- Centro: Catálogo Visual de Productos -->
    <center>
        <VBox spacing="10.0" style="-fx-padding: 15px;">
            <HBox spacing="10.0" alignment="CENTER_LEFT">
                <Label text="Catálogo de Platos y Bebidas" style="-fx-font-size: 15px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>
                <Region HBox.hgrow="ALWAYS"/>
                <TextField fx:id="txtBuscar" promptText="Buscar producto..." prefWidth="250.0"/>
            </HBox>
            <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
                <TilePane fx:id="tileProductos" hgap="12.0" vgap="12.0" prefColumns="3" style="-fx-padding: 5px;"/>
            </ScrollPane>
        </VBox>
    </center>

    <!-- Panel Derecho: Comanda Activa y Cobro -->
    <right>
        <VBox prefWidth="420.0" spacing="12.0" style="-fx-padding: 15px; -fx-background-color: white; -fx-border-color: #dee2e6; -fx-border-width: 0 0 0 1;">
            <Label text="Comanda y Cobro Activo" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>

            <!-- Tabla de Detalle de Venta -->
            <TableView fx:id="tblDetalle" VBox.vgrow="ALWAYS">
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="170.0"/>
                    <TableColumn fx:id="colCantidad" text="Cant" prefWidth="60.0"/>
                    <TableColumn fx:id="colPrecio" text="P. Unit" prefWidth="70.0"/>
                    <TableColumn fx:id="colSubtotal" text="Total" prefWidth="80.0"/>
                </columns>
            </TableView>

            <Button text="Eliminar Producto Seleccionado" onAction="#handleEliminarItem" maxWidth="Infinity" style="-fx-text-fill: #e63946;"/>

            <!-- Totales e IGV al 18% -->
            <VBox spacing="6.0" style="-fx-background-color: #f1faee; -fx-padding: 12px; -fx-background-radius: 6px;">
                <HBox>
                    <Label text="Subtotal:" style="-fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblSubtotal" text="S/ 0.00" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>
                <HBox>
                    <Label text="IGV (18%):" style="-fx-font-size: 13px;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblIgv" text="S/ 0.00" style="-fx-font-weight: bold; -fx-font-size: 13px;"/>
                </HBox>
                <Separator/>
                <HBox>
                    <Label text="TOTAL A PAGAR:" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #1d3557;"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Label fx:id="lblTotal" text="S/ 0.00" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #e63946;"/>
                </HBox>
            </VBox>

            <!-- Botones Grandes de Cobro Rápido -->
            <VBox spacing="8.0">
                <Label text="Métodos de Pago Directos:" style="-fx-font-weight: bold;"/>
                <HBox spacing="8.0">
                    <Button fx:id="btnEfectivo" text="Efectivo [F5]" onAction="#handleCobroEfectivo" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="42.0"
                            style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnTarjeta" text="Tarjeta [F6]" onAction="#handleCobroTarjeta" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="42.0"
                            style="-fx-background-color: #457b9d; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                    <Button fx:id="btnYape" text="Yape/Plin [F7]" onAction="#handleCobroYape" HBox.hgrow="ALWAYS" maxWidth="Infinity" prefHeight="42.0"
                            style="-fx-background-color: #7209b7; -fx-text-fill: white; -fx-font-weight: bold; -fx-cursor: hand;"/>
                </HBox>
            </VBox>
        </VBox>
    </right>

</BorderPane>
