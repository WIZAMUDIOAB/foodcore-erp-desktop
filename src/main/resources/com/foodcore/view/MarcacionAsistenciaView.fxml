<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodcore.controller.MarcacionAsistenciaController"
      alignment="CENTER" spacing="15.0" prefWidth="480.0" prefHeight="540.0"
      style="-fx-background-color: #f8f9fa; -fx-padding: 25px;">

    <Label text="CONTROL DE ASISTENCIA" style="-fx-font-weight: bold; -fx-font-size: 18px; -fx-text-fill: #1d3557;"/>
    <Label text="Digite su DNI en el teclado táctil para registrar marcación:" style="-fx-text-fill: #6c757d;"/>

    <TextField fx:id="txtDni" alignment="CENTER" editable="false" promptText="DNI (8 dígitos)"
               prefHeight="45.0" style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-background-radius: 6px;"/>

    <!-- Teclado Numérico en Pantalla -->
    <GridPane alignment="CENTER" hgap="10.0" vgap="10.0">
        <Button text="1" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="2" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="3" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

        <Button text="4" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="5" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="6" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <Button text="7" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="8" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="9" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Button text="C" onAction="#handleClear" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #e63946;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="0" onAction="#handleNumClick" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 18px; -fx-font-weight: bold;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="⌫" onAction="#handleBackspace" prefWidth="80.0" prefHeight="50.0" style="-fx-font-size: 16px; -fx-font-weight: bold;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
    </GridPane>

    <Label fx:id="lblEstado" wrapText="true" textAlignment="CENTER" style="-fx-font-weight: bold;"/>

    <Button text="REGISTRAR ASISTENCIA" onAction="#handleRegistrar"
            maxWidth="Infinity" prefHeight="45.0"
            style="-fx-background-color: #2a9d8f; -fx-text-fill: white; -fx-font-weight: bold; -fx-font-size: 14px; -fx-background-radius: 6px; -fx-cursor: hand;"/>

</VBox>
