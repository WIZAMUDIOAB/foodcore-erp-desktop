<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodcore.controller.MarcacionAsistenciaController"
      alignment="CENTER" spacing="16.0" prefWidth="490.0" prefHeight="580.0"
      style="-fx-background-color: -color-bg-base; -fx-padding: 30px 24px;">

    <!-- Encabezado -->
    <VBox alignment="CENTER" spacing="3.0">
        <Label text="Reloj de Asistencia" styleClass="view-heading"/>
        <Label text="Digite su número de DNI para registrar entrada o salida" styleClass="view-subheading"/>
    </VBox>

    <!-- Visor de DNI -->
    <TextField fx:id="txtDni" alignment="CENTER" editable="false" promptText="00000000"
               prefHeight="48.0" maxWidth="280.0"
               style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-background-color: white; -fx-border-color: -color-border-subtle; -fx-border-radius: 8px; -fx-background-radius: 8px;"/>

    <!-- Teclado Numerico Tactil -->
    <GridPane alignment="CENTER" hgap="12.0" vgap="12.0">
        <Button text="1" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
        <Button text="2" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
        <Button text="3" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="2" GridPane.rowIndex="0"/>

        <Button text="4" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
        <Button text="5" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
        <Button text="6" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="2" GridPane.rowIndex="1"/>

        <Button text="7" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
        <Button text="8" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
        <Button text="9" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="2" GridPane.rowIndex="2"/>

        <Button text="C" onAction="#handleClear" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: -color-accent-rose;" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
        <Button text="0" onAction="#handleNumClick" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 20px; -fx-font-weight: 700;" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        <Button text="⌫" onAction="#handleBackspace" prefWidth="85.0" prefHeight="54.0" styleClass="surface-card-interactive" style="-fx-font-size: 18px; -fx-font-weight: 700; -fx-text-fill: -color-ink-secondary;" GridPane.columnIndex="2" GridPane.rowIndex="3"/>
    </GridPane>

    <!-- Estado de Marcacion -->
    <VBox alignment="CENTER" minHeight="50.0" maxWidth="380.0">
        <Label fx:id="lblEstado" wrapText="true" textAlignment="CENTER"
               style="-fx-font-weight: 700; -fx-font-size: 12px;"/>
    </VBox>

    <Button text="Registrar Marcación" onAction="#handleRegistrar"
            maxWidth="320.0" prefHeight="46.0" styleClass="btn-primary"/>

</VBox>
