<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.AreaChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootGerencialStack" prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.DashboardController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <VBox minWidth="980.0" spacing="20.0" styleClass="pos-catalog-panel">
                    <children>

                        <!-- Encabezado del Dashboard Gerencial -->
                        <HBox alignment="CENTER_LEFT" minHeight="72.0" spacing="14.0" styleClass="surface-card">
                            <children>
                                <VBox spacing="3.0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Dashboard Gerencial y Analítica Financiera" />
                                                <Label styleClass="badge-pill-accent" text="EN TIEMPO REAL" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Indicadores clave del día (KPIs), evolución de ventas por hora, rentabilidad de carta y alertas de personal" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Button fx:id="btnActualizarDashboard" mnemonicParsing="false" onAction="#handleActualizarDashboard" styleClass="btn-secondary" text="Actualizar KPIs" />
                                <Button fx:id="btnExpandirVentana" mnemonicParsing="false" onAction="#handleExpandirVentana" styleClass="btn-secondary" text="⤢" />
                            </children>
                        </HBox>

                        <!-- 4 Tarjetas de KPIs del Día (Estilo SaaS Dribbble) -->
                        <GridPane hgap="16.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="25.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <!-- KPI 0: Ventas del Día -->
                                <VBox spacing="8.0" styleClass="surface-card" GridPane.columnIndex="0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="VENTAS DE HOY" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-accent">
                                                    <children>
                                                        <Label text="💰" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiVentasDia" styleClass="text-mono-lg-accent" text="S/ 0.00" />
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblVarHoyVsAyer" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                                <Label fx:id="lblDetalleAyer" styleClass="text-caption" text="vs ayer (S/ 0.00)" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- KPI 1: Ticket Promedio -->
                                <VBox spacing="8.0" styleClass="surface-card" GridPane.columnIndex="1">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="TICKET PROMEDIO" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-blue">
                                                    <children>
                                                        <Label text="💳" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiTicketPromedio" styleClass="text-mono-lg" text="S/ 0.00" />
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblVarMesVsAnteriorMini" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                                <Label styleClass="text-caption" text="mes vs anterior" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- KPI 2: Transacciones del Día -->
                                <VBox spacing="8.0" styleClass="surface-card" GridPane.columnIndex="2">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="NÚMERO DE TRANSACCIONES" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-success">
                                                    <children>
                                                        <Label text="🧾" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiTransacciones" styleClass="text-mono-lg-success" text="0" />
                                        <HBox alignment="CENTER_LEFT" spacing="6.0">
                                            <children>
                                                <Label fx:id="lblBadgeComprobantes" styleClass="badge-pill-accent" text="COMPLETADAS" />
                                                <Label styleClass="text-caption" text="comprobantes válidos" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- KPI 3: Plato Top -->
                                <VBox spacing="8.0" styleClass="surface-card" GridPane.columnIndex="3">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="PLATO ESTRELLA" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-amber">
                                                    <children>
                                                        <Label text="⭐" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiPlatoTop" styleClass="text-h2" text="Hamburguesa Royal" />
                                        <Label fx:id="lblKpiPlatoTopDetalle" styleClass="text-caption" text="18 unidades despachadas" />
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- Comparativas Automáticas de Períodos (v4.9.0 Fase 2.1) -->
                        <GridPane fx:id="panelComparativasDashboard" hgap="16.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="50.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="SOMETIMES" />
                            </rowConstraints>
                            <children>
                                <VBox spacing="6.0" styleClass="surface-card" GridPane.columnIndex="0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="text-overline" text="COMPARATIVA: VENTAS DE HOY VS. AYER" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblDashCompHoyBadge" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="BASELINE_LEFT" spacing="12.0">
                                            <children>
                                                <Label fx:id="lblDashCompHoyMonto" styleClass="text-mono-lg" text="S/ 0.00" />
                                                <Label fx:id="lblDashCompHoyDetalle" styleClass="text-caption" text="Hoy: S/ 0.00 · Ayer: S/ 0.00" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="6.0" styleClass="surface-card" GridPane.columnIndex="1">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="text-overline" text="COMPARATIVA: VENTAS DE ESTE MES VS. MES ANTERIOR" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblDashCompMesBadge" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="BASELINE_LEFT" spacing="12.0">
                                            <children>
                                                <Label fx:id="lblDashCompMesMonto" styleClass="text-mono-lg" text="S/ 0.00" />
                                                <Label fx:id="lblDashCompMesDetalle" styleClass="text-caption" text="Este mes: S/ 0.00 · Mes anterior: S/ 0.00" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </GridPane>

                        <!-- Fila Central: Gráfico de Barras Ventas por Hora + Reporte de Ventas por Mozo -->
                        <GridPane hgap="16.0" vgap="16.0">
                            <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="52.0" />
                                <ColumnConstraints hgrow="ALWAYS" percentWidth="48.0" />
                            </columnConstraints>
                            <rowConstraints>
                                <RowConstraints vgrow="ALWAYS" />
                            </rowConstraints>
                            <children>

                                <!-- Gráfico de Área Suavizado (Smooth Area Chart SaaS): Ventas por Hora -->
                                <VBox spacing="12.0" styleClass="surface-card" GridPane.columnIndex="0">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-h2" text="Ventas por Hora del Día (S/)" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="badge-pill-neutral" text="FLUJO HORARIO" />
                                            </children>
                                        </HBox>
                                        <AreaChart fx:id="areaChartVentas" animated="false" createSymbols="false" horizontalGridLinesVisible="false" legendVisible="false" prefHeight="260.0" verticalGridLinesVisible="false">
                                            <xAxis>
                                                <CategoryAxis label="Franja Horaria" side="BOTTOM" />
                                            </xAxis>
                                            <yAxis>
                                                <NumberAxis label="Soles (S/)" side="LEFT" />
                                            </yAxis>
                                        </AreaChart>
                                    </children>
                                </VBox>

                                <!-- Tabla: Reporte de Ventas por Mozo / Turno -->
                                <VBox spacing="12.0" styleClass="surface-card" GridPane.columnIndex="1">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-h2" text="Ventas por Mozo / Operador de Turno" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label styleClass="badge-pill-success" text="DESEMPEÑO" />
                                            </children>
                                        </HBox>
                                        <TableView fx:id="tblVentasMozo" prefHeight="260.0">
                                            <columns>
                                                <TableColumn fx:id="colMozoUsuario" prefWidth="150.0" text="Usuario / Rol" />
                                                <TableColumn fx:id="colMozoVentas" prefWidth="120.0" text="Ventas Totales" />
                                                <TableColumn fx:id="colMozoPedidos" prefWidth="95.0" text="Nro. Pedidos" />
                                                <TableColumn fx:id="colMozoTicket" prefWidth="120.0" text="Ticket Prom." />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                            </children>
                        </GridPane>

                        <!-- Tabla Inferior: Reporte de Rentabilidad y Escandallo -->
                        <VBox spacing="12.0" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT">
                                    <children>
                                        <Label styleClass="text-h2" text="Reporte de Rentabilidad por Platillo (Costo de Receta vs Precio de Carta)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label styleClass="badge-pill-accent" text="AUDITORÍA DE MARGEN" />
                                    </children>
                                </HBox>
                                <TableView fx:id="tblRentabilidad" prefHeight="220.0">
                                    <columns>
                                        <TableColumn fx:id="colRentPlatillo" prefWidth="340.0" text="Platillo" />
                                        <TableColumn fx:id="colRentCosto" prefWidth="210.0" text="Costo de Receta" />
                                        <TableColumn fx:id="colRentPrecio" prefWidth="210.0" text="Precio de Venta" />
                                        <TableColumn fx:id="colRentMargen" prefWidth="240.0" text="Margen de Ganancia (%)" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Alertas de Seguridad del Sistema (v5.1.0 ÍTEM 9) -->
                        <VBox fx:id="cardAlertasSeguridad" spacing="12.0" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="text-h2" text="Alertas de Seguridad del Sistema (Hoy)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblSecEstadoBadge" styleClass="badge-pill-success" text="SIN ANOMALÍAS" />
                                    </children>
                                </HBox>
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox spacing="4.0" styleClass="kpi-card, kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-card-title" text="INTENTOS FALLIDOS HOY" />
                                                <Label fx:id="lblSecIntentosFallidos" styleClass="kpi-value-24-accent" text="0" />
                                                <Label styleClass="kpi-card-subtitle" text="Logins o códigos 2FA rechazados" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" styleClass="kpi-card, kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-card-title" text="ANULACIONES HOY" />
                                                <Label fx:id="lblSecAnulacionesHoy" styleClass="kpi-value-24-amber" text="0" />
                                                <Label styleClass="kpi-card-subtitle" text="Anulaciones de pedidos y comprobantes" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" styleClass="kpi-card, kpi-card-secondary" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="kpi-card-title" text="ÚLTIMO ACCESO SOSPECHOSO" />
                                                <Label fx:id="lblSecUltimoSospechoso" styleClass="text-body-strong" text="Sin eventos sospechosos" wrapText="true" />
                                                <Label fx:id="lblSecUltimoSospechosoDetalle" styleClass="kpi-card-subtitle" text="Bitácora de auditoría de seguridad" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <!-- Alertas de Vencimiento de Personal (Próximos 30 días) (v4.4.0 §4) -->
                        <VBox spacing="10.0" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="text-h2" text="Alertas de Vencimiento de Personal (Próximos 30 días)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblCountAlertasPersonal" styleClass="badge-pill-warning" text="0 alertas" />
                                    </children>
                                </HBox>
                                <VBox fx:id="vboxAlertasVencimiento" spacing="8.0" />
                            </children>
                        </VBox>

                    </children>
                </VBox>
            </content>
        </ScrollPane>
    </children>
</StackPane>
