<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootClientesStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ClientesController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
            <!-- Cabecera -->
            <top>
                <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Clientes y CRM Minorista" />
                                                <Label styleClass="badge-pill-accent" text="CRM &amp; FINANZAS v5.0" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Maestro de clientes corporativos, minoristas DNI, historial de compras y programa de puntos" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnNuevoMinorista" mnemonicParsing="false" onAction="#handleAbrirModalNuevoMinorista" styleClass="btn-secondary" text="+ Nuevo Minorista (DNI)" />
                                <Button fx:id="btnNuevoCliente" mnemonicParsing="false" onAction="#handleAbrirModalNuevo" styleClass="btn-primary" text="+ Nuevo Cliente" />
                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#cargarClientesAsync" styleClass="btn-secondary" text="Actualizar" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <TextField fx:id="txtBuscar" prefWidth="340.0" promptText="Buscar por DNI, RUC, Teléfono o Nombre..." styleClass="form-text-field" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalClientes" styleClass="badge-pill-success" text="0 Clientes" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Centro: TabPane Corporativos / Minoristas y Ficha 360° -->
            <center>
                <HBox spacing="12.0" style="-fx-padding: 14px 16px;" styleClass="view-content" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Pestañas de Cartera Corporativa y Clientes Minoristas (v5.0.0) -->
                        <VBox spacing="8.0" style="-fx-padding: 14px;" styleClass="surface-card" HBox.hgrow="ALWAYS">
                            <children>
                                <TabPane fx:id="tabPaneClientes" tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                                    <tabs>
                                        <Tab fx:id="tabCorporativos" text="Clientes Corporativos (RUC)">
                                            <content>
                                                <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                                                    <children>
                                                        <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="colTipoDoc" prefWidth="65.0" text="Tipo" />
                                                                <TableColumn fx:id="colDocumento" prefWidth="110.0" text="Documento" />
                                                                <TableColumn fx:id="colRazonSocial" prefWidth="210.0" text="Razón Social / Nombre" />
                                                                <TableColumn fx:id="colContacto" prefWidth="130.0" text="Contacto" />
                                                                <TableColumn fx:id="colTelefono" prefWidth="95.0" text="Teléfono" />
                                                                <TableColumn fx:id="colLimiteCredito" prefWidth="95.0" text="Límite Créd." />
                                                                <TableColumn fx:id="colSaldoDeudor" prefWidth="95.0" text="Saldo Deudor" />
                                                                <TableColumn fx:id="colPuntos" prefWidth="70.0" text="Puntos" />
                                                                <TableColumn fx:id="colEstado" prefWidth="75.0" text="Estado" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>
                                        <Tab fx:id="tabMinoristas" text="Clientes Minoristas">
                                            <content>
                                                <VBox spacing="8.0" style="-fx-padding: 10 0 0 0;">
                                                    <children>
                                                        <TableView fx:id="tblClientesMinoristas" VBox.vgrow="ALWAYS">
                                                            <columns>
                                                                <TableColumn fx:id="colMinDni" minWidth="84.0" prefWidth="86.0" text="DNI" />
                                                                <TableColumn fx:id="colMinNombre" minWidth="135.0" prefWidth="144.0" text="Nombre Completo" />
                                                                <TableColumn fx:id="colMinTelefono" minWidth="90.0" prefWidth="92.0" text="Teléfono" />
                                                                <TableColumn fx:id="colMinEmail" minWidth="130.0" prefWidth="136.0" text="Email" />
                                                                <TableColumn fx:id="colMinFechaNac" minWidth="94.0" prefWidth="96.0" text="Fecha Nac." />
                                                                <TableColumn fx:id="colMinPuntos" minWidth="138.0" prefWidth="140.0" text="Puntos Acumulados" />
                                                                <TableColumn fx:id="colMinEstado" minWidth="72.0" prefWidth="74.0" text="Estado" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </content>
                                        </Tab>
                                    </tabs>
                                </TabPane>
                            </children>
                        </VBox>

                        <!-- Panel Detalle Lateral (.surface-card + Overline + Historial de Compras) -->
                        <VBox fx:id="panelFichaCliente" fillWidth="true" minWidth="355.0" prefWidth="372.0" spacing="6.0" style="-fx-padding: 12px;" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                    <children>
                                        <Label styleClass="text-h3" text="Ficha del Cliente" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblBadgeTipoCliente" styleClass="badge-pill-accent" text="PERFIL 360°" />
                                    </children>
                                </HBox>
                                <Region styleClass="client-sheet-divider" />

                                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent; -fx-background: transparent;" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                                    <content>
                                        <VBox fillWidth="true" spacing="4.0">
                                            <children>
                                                <!-- Sección 1: DATOS GENERALES -->
                                                <VBox spacing="2.0" style="-fx-padding: 6px 10px;" styleClass="client-section-box">
                                                    <children>
                                                        <Label styleClass="text-overline" text="DATOS GENERALES" />
                                                        <VBox spacing="0.0">
                                                            <children>
                                                                <Label styleClass="text-caption" text="NOMBRE COMPLETO / RAZÓN SOCIAL" />
                                                                <Label fx:id="lblDetalleRazonSocial" styleClass="text-body-strong" text="Seleccione un cliente" wrapText="true" />
                                                            </children>
                                                        </VBox>
                                                        <HBox spacing="10.0">
                                                            <children>
                                                                <VBox spacing="0.0" HBox.hgrow="ALWAYS">
                                                                    <children>
                                                                        <Label styleClass="text-caption" text="DOCUMENTO" />
                                                                        <Label fx:id="lblDetalleDocumento" styleClass="text-mono" text="-" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="0.0">
                                                                    <children>
                                                                        <Label styleClass="text-caption" text="NACIMIENTO" />
                                                                        <Label fx:id="lblDetalleCumpleanos" styleClass="text-mono-sm" text="-" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </HBox>
                                                        <VBox spacing="0.0">
                                                            <children>
                                                                <Label styleClass="text-caption" text="CONTACTO Y TELÉFONO" />
                                                                <Label fx:id="lblDetalleContacto" styleClass="text-body" text="-" wrapText="true" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="0.0">
                                                            <children>
                                                                <Label styleClass="text-caption" text="CORREO" />
                                                                <Label fx:id="lblDetalleEmail" styleClass="text-body" text="-" wrapText="true" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>

                                                <!-- Sección 2: FINANZAS -->
                                                <VBox fx:id="boxFinanzasFicha" spacing="2.0" style="-fx-padding: 5px 10px;" styleClass="client-section-box">
                                                    <children>
                                                        <Label styleClass="text-overline" text="FINANZAS" />
                                                        <VBox fx:id="boxCreditoCorpDetalle" spacing="3.0">
                                                            <children>
                                                                <VBox spacing="1.0">
                                                                    <children>
                                                                        <Label styleClass="text-caption" text="LÍMITE Y CONDICIÓN DE CRÉDITO" />
                                                                        <Label fx:id="lblDetalleLimite" styleClass="text-body-strong" text="-" />
                                                                    </children>
                                                                </VBox>
                                                                <VBox spacing="2.0" styleClass="client-debt-box">
                                                                    <children>
                                                                        <Label styleClass="text-overline" text="SALDO DEUDOR PENDIENTE" />
                                                                        <Label fx:id="lblDetalleSaldoDeudor" styleClass="kpi-value-24-accent" text="S/ 0.00" />
                                                                        <Label fx:id="lblDetalleComprobantes" styleClass="kpi-subtitle-muted" text="0 comprobantes al crédito" />
                                                                    </children>
                                                                </VBox>
                                                            </children>
                                                        </VBox>
                                                        <Label fx:id="lblDetalleMinoristaSinCredito" managed="false" styleClass="text-caption-muted" text="Cuenta minorista al contado (sin crédito corporativo)" visible="false" />
                                                    </children>
                                                </VBox>

                                                <!-- Sección 3: FIDELIZACIÓN Y ÚLTIMAS 10 COMPRAS (SPEC v5.0.0) -->
                                                <VBox spacing="2.0" style="-fx-padding: 6px 10px;" styleClass="client-section-box">
                                                    <children>
                                                        <Label styleClass="text-overline" text="FIDELIZACIÓN" />
                                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                            <children>
                                                                <Label fx:id="lblDetallePuntos" styleClass="badge-pill-accent" text="0 Puntos Acumulados" />
                                                                <Label fx:id="lblBadgeCumpleMes" managed="false" styleClass="badge-pill-success" text="MES DE CUMPLEAÑOS" visible="false" />
                                                            </children>
                                                        </HBox>
                                                        <Label fx:id="lblDetalleReglaFidelizacion" styleClass="text-caption-muted" text="S/ 1.00 = 1 pt · 100 pts = S/ 5.00 desc." />
                                                        <Label styleClass="text-caption" text="ÚLTIMAS 10 COMPRAS" />
                                                        <TableView fx:id="tblHistorialCompras" minHeight="96.0" prefHeight="104.0" styleClass="compact-table">
                                                            <columns>
                                                                <TableColumn fx:id="colCompraFecha" minWidth="74.0" prefWidth="76.0" text="Fecha" />
                                                                <TableColumn fx:id="colCompraMonto" minWidth="68.0" prefWidth="70.0" text="Monto" />
                                                                <TableColumn fx:id="colCompraProductos" minWidth="135.0" prefWidth="162.0" text="Productos" />
                                                            </columns>
                                                            <columnResizePolicy>
                                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                                            </columnResizePolicy>
                                                        </TableView>
                                                    </children>
                                                </VBox>
                                            </children>
                                        </VBox>
                                    </content>
                                </ScrollPane>

                                <!-- Acciones alineadas al fondo -->
                                <VBox fx:id="boxAccionesCliente" fillWidth="true" spacing="6.0">
                                    <children>
                                        <Button fx:id="btnEstadoCuentaPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGenerarEstadoCuentaPdf" styleClass="btn-primary" text="Estado de Cuenta (PDF)" />
                                        <HBox spacing="8.0">
                                            <children>
                                                <Button fx:id="btnEditarCliente" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEditarSeleccionado" styleClass="btn-secondary" text="Editar Datos" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnCambiarEstado" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCambiarEstado" styleClass="btn-secondary" text="Activar / Inactivar" HBox.hgrow="ALWAYS" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>
            </content>
        </ScrollPane>

        <!-- Modal Crear/Editar Cliente (Corporativo & Minorista) -->
        <VBox fx:id="modalCliente" alignment="CENTER" styleClass="modal-backdrop" visible="false">
            <children>
                <VBox maxWidth="470.0" spacing="12.0" styleClass="modal-card">
                    <children>
                        <Label fx:id="lblModalTitulo" styleClass="modal-title" text="Registrar Cliente" />
                        <VBox spacing="8.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox prefWidth="145.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-field-label" text="Segmento:" />
                                                <ComboBox fx:id="cbModalTipoCliente" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                            </children>
                                        </VBox>
                                        <VBox prefWidth="105.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-field-label" text="Tipo Doc:" />
                                                <ComboBox fx:id="cbModalTipoDoc" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Número Doc:" />
                                                <TextField fx:id="txtModalNumeroDoc" promptText="DNI 8d o RUC 11d" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label styleClass="form-field-label" text="Nombre Completo / Razón Social:" />
                                <TextField fx:id="txtModalRazonSocial" promptText="Nombre completo o empresa" styleClass="form-text-field" />

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Teléfono:" />
                                                <TextField fx:id="txtModalTelefono" promptText="987654321" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Fecha Nacimiento:" />
                                                <DatePicker fx:id="dpModalFechaNacimiento" maxWidth="1.7976931348623157E308" promptText="dd/mm/aaaa" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Contacto:" />
                                                <TextField fx:id="txtModalContacto" promptText="Persona contacto" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Correo Electrónico:" />
                                                <TextField fx:id="txtModalEmail" promptText="correo@cliente.pe" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <HBox fx:id="boxModalCredito" spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Límite Crédito (S/):" />
                                                <TextField fx:id="txtModalLimite" promptText="5000.00" styleClass="form-text-field" text="5000.00" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Días Crédito:" />
                                                <TextField fx:id="txtModalDiasCredito" promptText="30" styleClass="form-text-field" text="30" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Label fx:id="lblModalError" styleClass="text-danger" text="" wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCerrarModal" styleClass="btn-secondary" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardarCliente" styleClass="btn-primary" text="Guardar Cliente" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
