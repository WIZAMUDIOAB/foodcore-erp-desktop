<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootClientesStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ClientesController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
            <!-- Cabecera -->
            <top>
                <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Clientes y Cuentas Corporativas" />
                                                <Label styleClass="badge-pill-accent" text="FINANZAS v2.0" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Maestro de clientes para facturación, consumo a crédito y fidelización" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnNuevoCliente" mnemonicParsing="false" onAction="#handleAbrirModalNuevo" styleClass="btn-primary" text="+ Nuevo Cliente" />
                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#cargarClientesSincrono" styleClass="btn-secondary" text="Actualizar" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <TextField fx:id="txtBuscar" prefWidth="320.0" promptText="Buscar por RUC, DNI o Razón Social..." styleClass="form-text-field" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalClientes" styleClass="badge-pill-success" text="0 Clientes" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Centro: Tabla de Clientes y Ficha Detallada -->
            <center>
                <HBox spacing="16.0" styleClass="view-content" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Tabla Clientes -->
                        <VBox spacing="8.0" styleClass="stat-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="text-h3" text="Cartera de Clientes Registrados" />
                                <TableView fx:id="tblClientes" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colTipoDoc" prefWidth="75.0" text="Tipo" />
                                        <TableColumn fx:id="colDocumento" prefWidth="120.0" text="Documento" />
                                        <TableColumn fx:id="colRazonSocial" prefWidth="250.0" text="Razón Social / Nombre" />
                                        <TableColumn fx:id="colContacto" prefWidth="150.0" text="Contacto" />
                                        <TableColumn fx:id="colTelefono" prefWidth="110.0" text="Teléfono" />
                                        <TableColumn fx:id="colLimiteCredito" prefWidth="110.0" text="Límite Créd." />
                                        <TableColumn fx:id="colSaldoDeudor" prefWidth="110.0" text="Saldo Deudor" />
                                        <TableColumn fx:id="colPuntos" prefWidth="75.0" text="Puntos" />
                                        <TableColumn fx:id="colEstado" prefWidth="85.0" text="Estado" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY_FLEX_LAST_COLUMN" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Panel Detalle Lateral -->
                        <VBox prefWidth="320.0" spacing="16.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="text-h3" text="Ficha del Cliente" />
                                <VBox spacing="8.0">
                                    <children>
                                        <Label styleClass="text-body-caption" text="RAZÓN SOCIAL / TITULAR" />
                                        <Label fx:id="lblDetalleRazonSocial" styleClass="text-h4" text="Seleccione un cliente" wrapText="true" />

                                        <Label styleClass="text-body-caption" text="DOCUMENTO DE IDENTIDAD" />
                                        <Label fx:id="lblDetalleDocumento" styleClass="text-body-strong" text="-" />

                                        <Label styleClass="text-body-caption" text="CONTACTO Y TELÉFONO" />
                                        <Label fx:id="lblDetalleContacto" styleClass="text-body" text="-" />

                                        <Label styleClass="text-body-caption" text="CORREO ELECTRÓNICO" />
                                        <Label fx:id="lblDetalleEmail" styleClass="text-body" text="-" />

                                        <Label styleClass="text-body-caption" text="LÍMITE DE CRÉDITO" />
                                        <Label fx:id="lblDetalleLimite" styleClass="text-body-strong" text="-" />

                                        <Label styleClass="text-body-caption" text="PROGRAMA DE FIDELIZACIÓN" />
                                        <Label fx:id="lblDetallePuntos" styleClass="badge-pill-accent" text="0 Puntos Acumulados" />
                                    </children>
                                </VBox>

                                <VBox spacing="6.0" styleClass="stat-card-accent">
                                    <children>
                                        <Label styleClass="stat-card-title" text="SALDO DEUDOR PENDIENTE" />
                                        <Label fx:id="lblDetalleSaldoDeudor" styleClass="stat-card-value" text="S/ 0.00" />
                                        <Label fx:id="lblDetalleComprobantes" styleClass="stat-card-subtitle" text="0 comprobantes al crédito" />
                                    </children>
                                </VBox>

                                <VBox spacing="8.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <Region VBox.vgrow="ALWAYS" />
                                        <Button fx:id="btnEstadoCuentaPdf" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleGenerarEstadoCuentaPdf" styleClass="btn-primary" text="Estado de Cuenta (PDF)" />
                                        <Button fx:id="btnEditarCliente" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleEditarSeleccionado" styleClass="btn-secondary" text="Editar Datos" />
                                        <Button fx:id="btnCambiarEstado" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#handleCambiarEstado" styleClass="btn-kds-outline" text="Activar / Inactivar" />
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </HBox>
            </center>
        </BorderPane>
            </content>
        </ScrollPane>

        <!-- Modal Crear/Editar Cliente -->
        <VBox fx:id="modalCliente" alignment="CENTER" styleClass="modal-backdrop" visible="false">
            <children>
                <VBox maxWidth="450.0" spacing="16.0" styleClass="modal-card">
                    <children>
                        <Label fx:id="lblModalTitulo" styleClass="modal-title" text="Registrar Cliente Corporativo" />
                        <VBox spacing="10.0">
                            <children>
                                <HBox spacing="10.0">
                                    <children>
                                        <VBox prefWidth="120.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="form-field-label" text="Tipo Doc:" />
                                                <ComboBox fx:id="cbModalTipoDoc" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Número Doc:" />
                                                <TextField fx:id="txtModalNumeroDoc" promptText="20456789012" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label styleClass="form-field-label" text="Razón Social / Nombre Completo:" />
                                <TextField fx:id="txtModalRazonSocial" promptText="Corporación o cliente" styleClass="form-text-field" />

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Contacto:" />
                                                <TextField fx:id="txtModalContacto" promptText="Persona responsable" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Teléfono:" />
                                                <TextField fx:id="txtModalTelefono" promptText="988776655" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label styleClass="form-field-label" text="Correo Electrónico:" />
                                <TextField fx:id="txtModalEmail" promptText="facturacion@empresa.pe" styleClass="form-text-field" />

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Límite Crédito (S/):" />
                                                <TextField fx:id="txtModalLimite" promptText="5000.00" styleClass="form-text-field" text="5000.00" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Días Crédito:" />
                                                <TextField fx:id="txtModalDiasCredito" promptText="30" styleClass="form-text-field" text="30" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <Label fx:id="lblModalError" styleClass="text-danger" text="" wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCerrarModal" styleClass="btn-secondary" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardarCliente" styleClass="btn-primary" text="Guardar Cliente" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
