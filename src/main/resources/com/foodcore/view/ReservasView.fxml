<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootReservasStack" prefHeight="768.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ReservasController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
            <!-- Encabezado y KPIs -->
            <top>
                <VBox spacing="14.0">
                    <padding>
                        <Insets bottom="16.0" left="24.0" right="24.0" top="20.0" />
                    </padding>
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label styleClass="view-heading" text="Libro de Reservas y Bloqueo Preventivo" />
                                        <Label styleClass="view-subheading" text="Gestión de comensales anticipados, confirmaciones vía WhatsApp y bloqueo automático en Salón" />
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                    <children>
                                        <Button fx:id="btnNuevaReserva" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleAbrirModal" styleClass="btn-primary" text="Nueva Reserva">
                                            <graphic><FontIcon iconLiteral="fth-plus" iconSize="16" /></graphic>
                                        </Button>
                                        <Button fx:id="btnWhatsApp" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleEnviarWhatsApp" styleClass="btn-secondary" text="Enviar WhatsApp">
                                            <graphic><FontIcon iconLiteral="fth-message-square" iconSize="16" /></graphic>
                                        </Button>
                                        <Button fx:id="btnSentar" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleSentarReserva" styleClass="btn-secondary" text="Sentar Comensales">
                                            <graphic><FontIcon iconLiteral="fth-check" iconSize="16" /></graphic>
                                        </Button>
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- 4 KPI Cards de Reservas (v4.6.0 Fase 3) -->
                        <HBox spacing="14.0">
                            <children>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="RESERVAS DEL DÍA" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-blue">
                                                    <children>
                                                        <FontIcon iconLiteral="fth-calendar" iconSize="20" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiTotalReservas" styleClass="kpi-value-24-blue" text="0" />
                                        <Label styleClass="kpi-subtitle-muted" text="Mesas programadas" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="COMENSALES ESPERADOS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-success">
                                                    <children>
                                                        <FontIcon iconLiteral="fth-users" iconSize="20" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiPersonas" styleClass="kpi-value-24-success" text="0" />
                                        <Label styleClass="kpi-subtitle-muted" text="Personas en salón" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="MESAS COMPROMETIDAS" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-amber">
                                                    <children>
                                                        <FontIcon iconLiteral="fth-layers" iconSize="20" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiMesasComprometidas" styleClass="kpi-value-24-amber" text="0" />
                                        <Label styleClass="kpi-subtitle-muted" text="Con bloqueo en POS" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="ESTADO DE CONFIRMACIÓN" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-accent">
                                                    <children>
                                                        <FontIcon iconLiteral="fth-check-circle" iconSize="20" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiConfirmadas" styleClass="kpi-value-24-accent" text="0 / 0" />
                                        <Label styleClass="kpi-subtitle-muted" text="Confirmadas vs Pendientes" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Contenido Principal: Filtros y Tabla -->
            <center>
                <VBox spacing="12.0">
                    <padding>
                        <Insets bottom="20.0" left="24.0" right="24.0" top="4.0" />
                    </padding>
                    <children>
                        <!-- Barra de Filtros -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="surface-card">
                            <children>
                                <Label styleClass="form-field-label" text="Fecha:" />
                                <DatePicker fx:id="dpFecha" onAction="#handleFiltrar" prefWidth="150.0" />

                                <Label styleClass="form-field-label" text="Estado:" />
                                <ComboBox fx:id="cmbFiltroEstado" onAction="#handleFiltrar" prefWidth="150.0" />

                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalRegistros" styleClass="text-caption" text="0 reservas encontradas" />
                                <Button graphicTextGap="8.0" mnemonicParsing="false" onAction="#cargarDatos" styleClass="btn-secondary" text="Actualizar">
                                    <graphic><FontIcon iconLiteral="fth-refresh-cw" iconSize="16" /></graphic>
                                </Button>
                            </children>
                        </HBox>

                        <!-- Tabla de Reservas -->
                        <TableView fx:id="tblReservas" VBox.vgrow="ALWAYS">
                            <placeholder>
                                <VBox alignment="CENTER" spacing="12.0">
                                    <children>
                                        <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="text-muted" />
                                        <Label styleClass="h3" text="No hay registros" />
                                        <Label styleClass="text-secondary" text="No se encontraron datos para el período seleccionado." />
                                    </children>
                                </VBox>
                            </placeholder>
                            <columns>
                                <TableColumn fx:id="colHora" prefWidth="85.0" text="Hora" />
                                <TableColumn fx:id="colMesa" prefWidth="85.0" text="Mesa" />
                                <TableColumn fx:id="colCliente" prefWidth="210.0" text="Cliente" />
                                <TableColumn fx:id="colTelefono" prefWidth="130.0" text="Teléfono / WhatsApp" />
                                <TableColumn fx:id="colPersonas" prefWidth="85.0" text="Personas" />
                                <TableColumn fx:id="colEstado" prefWidth="125.0" text="Estado" />
                                <TableColumn fx:id="colNotas" prefWidth="280.0" text="Notas / Requerimientos Especiales" />
                            </columns>
                            <columnResizePolicy>
                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                            </columnResizePolicy>
                        </TableView>
                    </children>
                </VBox>
            </center>
        </BorderPane>
            </content>
        </ScrollPane>

        <!-- Modal Nueva Reserva -->
        <VBox fx:id="modalReserva" alignment="CENTER" styleClass="modal-backdrop" visible="false">
            <children>
                <VBox maxHeight="680.0" maxWidth="500.0" prefWidth="500.0" spacing="0.0" styleClass="card, modal-card">
                    <children>
                        <!-- HEADER -->
                        <VBox spacing="4.0" styleClass="modal-header">
                            <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0" /></padding>
                            <children>
                                <Label styleClass="h2" text="Registrar Nueva Reserva de Mesa" />
                                <Label styleClass="text-secondary" text="Indique cliente, horario y mesa asignada para la reserva" />
                            </children>
                        </VBox>

                        <!-- BODY -->
                        <ScrollPane fitToWidth="true" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="16.0" styleClass="modal-body">
                                    <padding><Insets top="0.0" right="24.0" bottom="24.0" left="24.0" /></padding>
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="label-form" text="Nombre del Cliente" />
                                                <TextField fx:id="txtCliente" promptText="Ej. Mariana Valdivia" styleClass="input-field" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="16.0">
                                            <children>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Teléfono / Celular (WhatsApp)" />
                                                        <TextField fx:id="txtTelefono" promptText="987654321" styleClass="input-field" />
                                                    </children>
                                                </VBox>
                                                <VBox prefWidth="130.0" spacing="8.0">
                                                    <children>
                                                        <Label styleClass="label-form" text="N° Personas" />
                                                        <TextField fx:id="txtPersonas" alignment="CENTER" promptText="4" styleClass="input-field" text="2" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox spacing="16.0">
                                            <children>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Fecha de Reserva" />
                                                        <DatePicker fx:id="dpModalFecha" maxWidth="1.7976931348623157E308" styleClass="form-date-picker" />
                                                    </children>
                                                </VBox>
                                                <VBox prefWidth="130.0" spacing="8.0">
                                                    <children>
                                                        <Label styleClass="label-form" text="Hora (HH:mm)" />
                                                        <TextField fx:id="txtModalHora" alignment="CENTER" promptText="20:00" styleClass="input-field" text="20:00" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <HBox spacing="16.0">
                                            <children>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Mesa Asignada" />
                                                        <ComboBox fx:id="cmbModalMesa" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Estado" />
                                                        <ComboBox fx:id="cmbModalEstado" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="label-form" text="Notas / Peticiones Especiales" />
                                                <TextField fx:id="txtNotas" promptText="Ej. Aniversario, decoración especial, silla para bebé..." styleClass="input-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- FOOTER -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="modal-footer">
                            <padding><Insets top="16.0" right="24.0" bottom="24.0" left="24.0" /></padding>
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCerrarModal" styleClass="btn-secondary" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardarReserva" styleClass="btn-primary" text="Guardar Reserva" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
