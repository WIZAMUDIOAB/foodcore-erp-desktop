<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.foodcore.controller.SalonMesasController"
      spacing="16.0" style="-fx-padding: 24px; -fx-background-color: -color-bg-base;">

    <!-- Topbar del Salon -->
    <HBox alignment="CENTER_LEFT" spacing="16.0">
        <VBox spacing="2.0">
            <Label text="Salón y Comedores" styleClass="view-heading"/>
            <Label text="Distribución de mesas y seguimiento de consumos en tiempo real" styleClass="view-subheading"/>
        </VBox>
        <Region HBox.hgrow="ALWAYS"/>

        <!-- Leyenda de Estados de Mesa -->
        <HBox alignment="CENTER" spacing="12.0"
              style="-fx-background-color: -color-bg-surface; -fx-padding: 6px 14px; -fx-background-radius: 20px; -fx-border-color: -color-border-subtle; -fx-border-radius: 20px;">
            <HBox alignment="CENTER" spacing="6.0">
                <Label style="-fx-background-color: -color-accent-emerald; -fx-min-width: 10px; -fx-min-height: 10px; -fx-background-radius: 5px;"/>
                <Label text="Libre" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: -color-ink-secondary;"/>
            </HBox>
            <Separator orientation="VERTICAL"/>
            <HBox alignment="CENTER" spacing="6.0">
                <Label style="-fx-background-color: -color-brand-ember; -fx-min-width: 10px; -fx-min-height: 10px; -fx-background-radius: 5px;"/>
                <Label text="En servicio" style="-fx-font-size: 11px; -fx-font-weight: 600; -fx-text-fill: -color-ink-secondary;"/>
            </HBox>
        </HBox>

        <Button text="⟳ Actualizar" onAction="#cargarMesas" styleClass="btn-secondary"/>
    </HBox>

    <Separator style="-fx-opacity: 0.6;"/>

    <!-- Cuadricula de Mesas con Scroll -->
    <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS" style="-fx-background-color: transparent;">
        <FlowPane fx:id="flowMesas" hgap="16.0" vgap="16.0" style="-fx-padding: 6px;"/>
    </ScrollPane>

</VBox>
