<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.PromocionesController">
    <content>
        <VBox minWidth="960.0" spacing="20.0" styleClass="pos-catalog-panel">
            <children>
                <!-- Topbar del Módulo (§11) -->
                <HBox alignment="CENTER_LEFT" minHeight="72.0" spacing="16.0" styleClass="surface-card">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="view-heading" text="Promociones y Descuentos Automáticos" />
                                        <Label styleClass="badge-pill-success" text="MOTOR DINÁMICO v2.0" />
                                    </children>
                                </HBox>
                                <Label styleClass="view-subheading" text="Reglas comerciales: 2x1, 3x2, descuentos porcentuales y cupones de cumpleaños" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleNuevaPromocion" styleClass="btn-primary" text="+ Nueva Promoción" />
                        <Button mnemonicParsing="false" onAction="#handleActualizar" styleClass="btn-secondary" text="↻ Actualizar" />
                    </children>
                </HBox>

                <!-- KPI Cards de Marketing y Fidelización -->
                <HBox spacing="16.0">
                    <children>
                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="metric-label" text="TOTAL PROMOCIONES" />
                                <Label fx:id="lblTotalPromos" styleClass="metric-value" text="4" />
                                <Label styleClass="text-caption-muted" text="Reglas configuradas en catálogo" />
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="metric-label" text="PROMOCIONES ACTIVAS" />
                                <Label fx:id="lblPromosActivas" styleClass="metric-value-primary" text="4" />
                                <Label styleClass="text-caption-muted" text="Aplicándose en POS en tiempo real" />
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="metric-label" text="TIPO MÁS POPULAR" />
                                <Label fx:id="lblTipoPopular" styleClass="metric-value" text="2x1 y Porcentaje" />
                                <Label styleClass="text-caption-muted" text="Alitas y Hamburguesas" />
                            </children>
                        </VBox>

                        <VBox styleClass="metric-card" HBox.hgrow="ALWAYS">
                            <children>
                                <Label styleClass="metric-label" text="PROGRAMA FIDELIZACIÓN" />
                                <Label fx:id="lblReglaFidelizacion" styleClass="metric-value" text="S/ 1 = 1 Pto" />
                                <Label styleClass="text-caption-muted" text="10 Ptos = S/ 1 Desc · Cumpleaños 15% OFF" />
                            </children>
                        </VBox>
                    </children>
                </HBox>

                <!-- Filtros y Búsqueda -->
                <HBox alignment="CENTER_LEFT" minHeight="56.0" spacing="12.0" styleClass="surface-card">
                    <children>
                        <TextField fx:id="txtBuscar" prefWidth="280.0" promptText="🔍 Buscar por código o nombre..." styleClass="search-box" />
                        <ComboBox fx:id="cmbFiltroTipo" prefWidth="180.0" promptText="Tipo de Promoción" styleClass="combo-box" />
                        <ComboBox fx:id="cmbFiltroEstado" prefWidth="150.0" promptText="Estado" styleClass="combo-box" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblConteoRegistros" styleClass="text-caption-muted" text="Mostrando 4 promociones" />
                    </children>
                </HBox>

                <!-- Tabla Principal de Promociones con CONSTRAINED_RESIZE_POLICY -->
                <TableView fx:id="tblPromociones" minHeight="380.0" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colCodigo" prefWidth="120.0" text="CÓDIGO" />
                        <TableColumn fx:id="colNombre" prefWidth="200.0" text="NOMBRE / DESCRIPCIÓN" />
                        <TableColumn fx:id="colTipo" prefWidth="110.0" text="TIPO" />
                        <TableColumn fx:id="colDescuento" prefWidth="110.0" text="BENEFICIO" />
                        <TableColumn fx:id="colAplicaA" prefWidth="140.0" text="APLICA A" />
                        <TableColumn fx:id="colHorario" prefWidth="130.0" text="DÍAS / HORARIO" />
                        <TableColumn fx:id="colEstado" prefWidth="90.0" text="ESTADO" />
                        <TableColumn fx:id="colAcciones" prefWidth="130.0" text="ACCIONES" />
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>
            </children>
        </VBox>
    </content>
</ScrollPane>
