<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootContableStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ReportesContablesController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
                    <!-- Cabecera -->
                    <top>
                        <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="view-heading" text="Reportes Contables y PLE SUNAT" />
                                                        <Label styleClass="badge-pill-accent" text="FINANZAS v2.0" />
                                                    </children>
                                                </HBox>
                                                <Label styleClass="view-subheading" text="Exportación oficial de registros contables 14.1 (Ventas), 8.1 (Compras) y Cierre Z mensual" />
                                            </children>
                                        </VBox>
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <children>
                                                <Button fx:id="btnExportarVentasSunat" mnemonicParsing="false" onAction="#handleExportarVentasSunat" styleClass="btn-primary" text="Exportar Ventas 14.1" />
                                                <Button fx:id="btnExportarComprasSunat" mnemonicParsing="false" onAction="#handleExportarComprasSunat" styleClass="btn-secondary" text="Exportar Compras 8.1" />
                                                <Button fx:id="btnExportarResumenCaja" mnemonicParsing="false" onAction="#handleExportarResumenCaja" styleClass="btn-secondary" text="Resumen Caja Z (PDF)" />
                                            </children>
                                        </HBox>
                                    </children>
                                </HBox>

                                <!-- Filtros de Período -->
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label styleClass="text-body-strong" text="Período:" />
                                        <ComboBox fx:id="cbPeriodo" prefWidth="160.0" styleClass="form-combo-box" />
                                        <Label styleClass="text-body-strong" text="Desde:" />
                                        <DatePicker fx:id="dpInicio" prefWidth="148.0" styleClass="form-date-picker" />
                                        <Label styleClass="text-body-strong" text="Hasta:" />
                                        <DatePicker fx:id="dpFin" prefWidth="148.0" styleClass="form-date-picker" />
                                        <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#handleFiltrar" styleClass="btn-secondary" text="Consultar" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblEstadoExportacion" styleClass="text-body-caption" text="Listo para exportar" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </top>

                    <!-- Centro: Tarjetas KPI con Tintes Pastel (v4.4.0 §3) y Tabla PLE -->
                    <center>
                        <VBox spacing="16.0" styleClass="view-content" BorderPane.alignment="CENTER">
                            <children>
                                <!-- Tarjetas de KPIs Financieros (.kpi-card con tintes pastel e iconos) -->
                                <HBox spacing="14.0">
                                    <children>
                                        <VBox fx:id="cardKpiVentas" spacing="6.0" styleClass="kpi-card, kpi-card-sales" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="kpi-card-title" text="VENTAS TOTALES PERÍODO" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label styleClass="kpi-icon-badge-sales" text="💰" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblTotalVentas" styleClass="kpi-card-value" text="S/ 0.00" />
                                                <Label styleClass="kpi-card-subtitle" text="Facturación bruta acumulada" />
                                            </children>
                                        </VBox>
                                        <VBox fx:id="cardKpiBase" spacing="6.0" styleClass="kpi-card, kpi-card-taxable" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="kpi-card-title" text="BASE IMPONIBLE (VENTAS)" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label styleClass="kpi-icon-badge-taxable" text="📊" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblBaseImponible" styleClass="kpi-card-value" text="S/ 0.00" />
                                                <Label styleClass="kpi-card-subtitle" text="Ventas netas sin IGV" />
                                            </children>
                                        </VBox>
                                        <VBox fx:id="cardKpiIgv" spacing="6.0" styleClass="kpi-card, kpi-card-igv" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="kpi-card-title" text="IGV TRASLADADO FISCAL (18%)" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label styleClass="kpi-icon-badge-igv" text="🧾" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblTotalIgv" styleClass="kpi-card-value" text="S/ 0.00" />
                                                <Label styleClass="kpi-card-subtitle" text="Impuesto general a las ventas" />
                                            </children>
                                        </VBox>
                                        <VBox fx:id="cardKpiCompras" spacing="6.0" styleClass="kpi-card, kpi-card-purchases" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT">
                                                    <children>
                                                        <Label styleClass="kpi-card-title" text="COMPRAS TOTALES PERÍODO" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label styleClass="kpi-icon-badge-purchases" text="📦" />
                                                    </children>
                                                </HBox>
                                                <Label fx:id="lblTotalCompras" styleClass="kpi-card-value" text="S/ 0.00" />
                                                <Label styleClass="kpi-card-subtitle" text="Crédito fiscal adquisiciones" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <!-- Tabla Vista Previa PLE SUNAT 14.1 -->
                                <VBox spacing="8.0" styleClass="stat-card" VBox.vgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="text-h3" text="Registro de Ventas e Ingresos (Vista Previa Formato 14.1)" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblContadorFilas" styleClass="badge-pill-success" text="0 Comprobantes" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tblVentasSunat" minHeight="380.0" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="colFecha" prefWidth="100.0" text="Fecha" />
                                                <TableColumn fx:id="colComprobante" prefWidth="120.0" text="Comprobante" />
                                                <TableColumn fx:id="colCliente" prefWidth="220.0" text="Cliente / Razón Social" />
                                                <TableColumn fx:id="colBaseImponible" prefWidth="110.0" text="Base Imponible" />
                                                <TableColumn fx:id="colIgv" prefWidth="95.0" text="IGV (18%)" />
                                                <TableColumn fx:id="colTotal" prefWidth="110.0" text="Total" />
                                                <TableColumn fx:id="colMedioPago" prefWidth="120.0" text="Medio de Pago" />
                                                <TableColumn fx:id="colEstado" prefWidth="90.0" text="Estado" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                                            <children>
                                                <Button fx:id="btnAnteriorVentas" mnemonicParsing="false" onAction="#handlePaginaAnterior" styleClass="btn-secondary" text="Anterior" />
                                                <Label fx:id="lblPaginaVentas" styleClass="text-caption" text="Página 1 de 1" />
                                                <Button fx:id="btnSiguienteVentas" mnemonicParsing="false" onAction="#handlePaginaSiguiente" styleClass="btn-secondary" text="Siguiente" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </center>
                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
