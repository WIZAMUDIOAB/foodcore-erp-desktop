<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="720.0" prefWidth="1120.0" styleClass="kds-viewport" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.KitchenDisplayController">

    <!-- Encabezado de Cocina KDS (§7) -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="kds-header">
            <VBox spacing="2.0">
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label styleClass="text-h1-inverse" text="Línea de Cocina (KDS)" />
                    <Label styleClass="badge-pill-success" text="TIEMPO REAL" />
                </HBox>
                <Label styleClass="text-caption-muted" text="Tablero Kanban por ítem individual · Sincronización TCP Puerto 9090" />
            </VBox>
            <Region HBox.hgrow="ALWAYS" />
            <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="login-status-chip">
                <Region styleClass="status-dot-online" />
                <Label fx:id="lblSocketStatus" styleClass="text-caption-inverse" text="Socket TCP: Activo" />
            </HBox>
            <Button mnemonicParsing="false" onAction="#handleRefrescar" styleClass="btn-kds-outline" text="Actualizar" />
            <Button mnemonicParsing="false" onAction="#handleSimularComanda" styleClass="btn-primary" text="+ Simular Ítems" />
        </HBox>
    </top>

    <!-- Tablero Kanban 3 Columnas: Pendiente -> En preparación -> Listo (§7) -->
    <center>
        <GridPane hgap="16.0" styleClass="kds-board-grid">
            <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.33" />
                <ColumnConstraints hgrow="ALWAYS" percentWidth="33.34" />
            </columnConstraints>
            <rowConstraints>
                <RowConstraints vgrow="ALWAYS" />
            </rowConstraints>
            <children>

                <!-- Columna 1: PENDIENTE -->
                <VBox spacing="12.0" styleClass="kds-kanban-column" GridPane.columnIndex="0">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="kds-column-overline" text="PENDIENTE" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCountPendiente" styleClass="kds-column-counter" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="vboxColPendiente" spacing="12.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Columna 2: EN PREPARACIÓN -->
                <VBox spacing="12.0" styleClass="kds-kanban-column" GridPane.columnIndex="1">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="kds-column-overline" text="EN PREPARACIÓN" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCountEnPreparacion" styleClass="kds-column-counter" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="vboxColEnPreparacion" spacing="12.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <!-- Columna 3: LISTO -->
                <VBox spacing="12.0" styleClass="kds-kanban-column" GridPane.columnIndex="2">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label styleClass="kds-column-overline" text="LISTO" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblCountListo" styleClass="kds-column-counter" text="0" />
                            </children>
                        </HBox>
                        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox fx:id="vboxColListo" spacing="12.0" />
                            </content>
                        </ScrollPane>
                    </children>
                </VBox>

                <FlowPane fx:id="flowComandas" managed="false" visible="false" />
            </children>
        </GridPane>
    </center>

    <!-- Barra Inferior de Telemetría SLA (§7) -->
    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="24.0" styleClass="kds-footer">
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Region styleClass="status-dot-online" />
                <Label styleClass="text-caption-inverse" text="&lt; 5 min (En tiempo)" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Region styleClass="status-dot-warning" />
                <Label styleClass="text-caption-inverse" text="5–10 min (Atención)" />
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Region styleClass="status-dot-danger" />
                <Label styleClass="text-caption-inverse" text="&gt; 10 min (Crítico · Pulso SLA)" />
            </HBox>
            <Region HBox.hgrow="ALWAYS" />
            <Label fx:id="lblContadorActivas" styleClass="text-mono-kds" text="Ítems en Cocina: 0" />
        </HBox>
    </bottom>

</BorderPane>
