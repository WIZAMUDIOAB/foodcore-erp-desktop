<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodcore.controller.KitchenDisplayController"
            prefHeight="720.0" prefWidth="1100.0" style="-fx-background-color: #212529;">

    <!-- Encabezado Oscuro de Cocina -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 15px 25px; -fx-background-color: #1a1d20;">
            <Label text="KDS COCINA - MONITOR DE COMANDAS EN TIEMPO REAL (IU04/IU09)"
                   style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #f8f9fa;"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblSocketStatus" text="Socket TCP: Puerto 9090 [Activo]"
                   style="-fx-text-fill: #2a9d8f; -fx-font-weight: bold;"/>
            <Button text="Simular Nueva Comanda" onAction="#handleSimularComanda"
                    style="-fx-background-color: #457b9d; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </top>

    <!-- Contenedor Desplazable de Comandas Activas -->
    <center>
        <ScrollPane fitToHeight="true" fitToWidth="false" style="-fx-background-color: transparent; -fx-padding: 15px;">
            <FlowPane fx:id="flowComandas" hgap="20.0" vgap="20.0" style="-fx-background-color: transparent;"/>
        </ScrollPane>
    </center>

    <bottom>
        <HBox alignment="CENTER_LEFT" spacing="20.0" style="-fx-padding: 10px 25px; -fx-background-color: #1a1d20;">
            <HBox alignment="CENTER" spacing="8.0">
                <Label style="-fx-background-color: #2a9d8f; -fx-min-width: 14px; -fx-min-height: 14px; -fx-background-radius: 7px;"/>
                <Label text="0 a 5 min" style="-fx-text-fill: #ced4da; -fx-font-size: 12px;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="8.0">
                <Label style="-fx-background-color: #e9c46a; -fx-min-width: 14px; -fx-min-height: 14px; -fx-background-radius: 7px;"/>
                <Label text="5 a 10 min (Alerta)" style="-fx-text-fill: #ced4da; -fx-font-size: 12px;"/>
            </HBox>
            <HBox alignment="CENTER" spacing="8.0">
                <Label style="-fx-background-color: #e63946; -fx-min-width: 14px; -fx-min-height: 14px; -fx-background-radius: 7px;"/>
                <Label text="&gt; 10 min (Crítico)" style="-fx-text-fill: #ced4da; -fx-font-size: 12px;"/>
            </HBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="lblContadorActivas" text="Comandas en Cocina: 0" style="-fx-text-fill: #adb5bd; -fx-font-weight: bold;"/>
        </HBox>
    </bottom>

</BorderPane>
