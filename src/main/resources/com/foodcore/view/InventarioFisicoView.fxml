<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootInventarioFisicoStack" prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.InventarioFisicoController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="980.0" styleClass="pos-catalog-panel">
                    <top>
                        <VBox minHeight="125.0" spacing="14.0" styleClass="surface-card">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <VBox spacing="2.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                                    <children>
                                                        <Label styleClass="view-heading" text="Toma de Inventario Físico" />
                                                        <Label styleClass="badge-pill-accent" text="AJUSTE KÁRDEX v5.2" />
                                                    </children>
                                                </HBox>
                                                <Label styleClass="view-subheading" text="Compare el stock en sistema contra el conteo físico en almacén y registre ajustes atómicos AJUSTE_INV" />
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnRecargarConteo" mnemonicParsing="false" onAction="#handleRecargar" styleClass="btn-secondary" text="Recargar Stock" />
                                        <Button fx:id="btnConfirmarAjuste" mnemonicParsing="false" onAction="#handleConfirmarAjustes" styleClass="btn-primary" text="Confirmar Ajuste de Inventario" />
                                    </children>
                                </HBox>

                                <Region styleClass="divider-horizontal" />

                                <HBox alignment="CENTER_LEFT" spacing="14.0">
                                    <children>
                                        <TextField fx:id="txtBuscarInsumo" promptText="Buscar por código o nombre de insumo..." styleClass="input-field" HBox.hgrow="ALWAYS" />
                                        <TextField fx:id="txtMotivoAjuste" prefWidth="280.0" promptText="Motivo del conteo (ej. Cierre semanal)" styleClass="input-field" />
                                        <CheckBox fx:id="chkSoloDiferencias" mnemonicParsing="false" onAction="#handleFiltrar" styleClass="text-body-strong" text="Solo con diferencia" />
                                        <Label fx:id="lblResumenConteo" styleClass="text-caption" text="0 insumos · 0 con diferencia" />
                                    </children>
                                </HBox>
                            </children>
                        </VBox>
                    </top>

                    <center>
                        <VBox spacing="10.0" styleClass="kardex-table-wrapper" BorderPane.alignment="CENTER">
                            <children>
                                <TableView fx:id="tblConteoFisico" editable="true" minHeight="440.0" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colCodigo" prefWidth="110.0" text="Código" />
                                        <TableColumn fx:id="colNombre" prefWidth="240.0" text="Insumo" />
                                        <TableColumn fx:id="colUnidad" prefWidth="95.0" text="Unidad" />
                                        <TableColumn fx:id="colStockSistema" prefWidth="135.0" text="Stock Sistema" />
                                        <TableColumn fx:id="colStockContado" prefWidth="165.0" text="Stock Contado (Editable)" />
                                        <TableColumn fx:id="colDiferencia" prefWidth="135.0" text="Diferencia (+/-)" />
                                        <TableColumn fx:id="colValorDiferencia" prefWidth="150.0" text="Impacto (S/)" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </center>
                </BorderPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
