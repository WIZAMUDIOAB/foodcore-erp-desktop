<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<VBox alignment="CENTER" prefHeight="580.0" prefWidth="500.0" spacing="0.0" styleClass="card, modal-card" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.MenuQrModalController">

    <!-- Header Modal -->
    <VBox spacing="4.0" styleClass="modal-header">
        <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0" /></padding>
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label styleClass="h2" text="Menú Digital QR Dinámico" />
            <Label styleClass="badge-pill-success" text="ZXING 3.5" />
        </HBox>
        <Label styleClass="text-secondary" text="Escanee con cualquier smartphone para ver la carta actualizada" />
    </VBox>

    <!-- BODY -->
    <ScrollPane fitToWidth="true" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
        <content>
            <VBox alignment="CENTER" spacing="16.0" styleClass="modal-body">
                <padding><Insets top="0.0" right="24.0" bottom="24.0" left="24.0" /></padding>

                <!-- Contenedor del Código QR -->
                <VBox alignment="CENTER" prefHeight="260.0" prefWidth="260.0" spacing="10.0" styleClass="qr-modal-box">
                    <ImageView fx:id="imgCodigoQr" fitHeight="220.0" fitWidth="220.0" pickOnBounds="true" preserveRatio="true" />
                    <Label fx:id="lblEstadoQr" styleClass="text-caption-muted" text="Código QR activo y sincronizado" />
                </VBox>

                <!-- URL de Red Local para Clientes (v4.3.2) -->
                <VBox maxWidth="1.7976931348623157E308" spacing="8.0" styleClass="card">
                    <Label styleClass="label-form" text="ENLACE DEL MENÚ DIGITAL QR (TÚNEL PÚBLICO / WI-FI)" />
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <TextField fx:id="txtUrlMenu" editable="false" styleClass="input-field" HBox.hgrow="ALWAYS" />
                        <Button graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleAbrirEnNavegador" styleClass="btn-secondary" text="Probar">
                            <graphic><FontIcon iconLiteral="fth-globe" iconSize="16" /></graphic>
                        </Button>
                    </HBox>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>

    <!-- FOOTER -->
    <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="modal-footer">
        <padding><Insets top="16.0" right="24.0" bottom="24.0" left="24.0" /></padding>
        <Button graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleCerrar" prefHeight="42.0" styleClass="btn-secondary" text="Cerrar" />
        <Button fx:id="btnImprimirQr" graphicTextGap="8.0" mnemonicParsing="false" onAction="#handleImprimirQr" prefHeight="42.0" styleClass="btn-primary" text="Imprimir QR en Ticketera">
            <graphic><FontIcon iconLiteral="fth-printer" iconSize="16" /></graphic>
        </Button>
    </HBox>

</VBox>
