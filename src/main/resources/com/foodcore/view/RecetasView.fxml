<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootRecetasStack" prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.RecetasController">
    <children>
        <BorderPane styleClass="pos-catalog-panel">

            <!-- Encabezado -->
            <top>
                <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="surface-card">
                    <children>
                        <VBox spacing="2.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="view-heading" text="Recetas Estándar y Escandallo de Cocina" />
                                        <Label styleClass="badge-pill-accent" text="DESCUENTO AUTOMÁTICO POS" />
                                    </children>
                                </HBox>
                                <Label styleClass="view-subheading" text="Seleccione un platillo a la izquierda para configurar sus insumos y gramos/unidades requeridas por porción" />
                            </children>
                        </VBox>
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="lblPlatilloActivoHeader" styleClass="text-h2" text="Platillo: Hamburguesa Clásica" />
                    </children>
                </HBox>
            </top>

            <!-- Centro: Split 38% Platillos a la izquierda -> 62% Insumos de la Receta a la derecha (§2.3) -->
            <center>
                <GridPane hgap="16.0" styleClass="kardex-table-wrapper">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="38.0" />
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="62.0" />
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints vgrow="ALWAYS" />
                    </rowConstraints>
                    <children>

                        <!-- Izquierda: Lista de Platillos -->
                        <VBox spacing="10.0" styleClass="surface-card" GridPane.columnIndex="0">
                            <children>
                                <Label styleClass="text-h2" text="1. Seleccionar Platillo" />
                                <TableView fx:id="tblPlatillos" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colProdCodigo" prefWidth="85.0" text="SKU" />
                                        <TableColumn fx:id="colProdNombre" prefWidth="195.0" text="Platillo" />
                                        <TableColumn fx:id="colProdPrecio" prefWidth="95.0" text="Precio" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                        <!-- Derecha: Insumos Asociados a la Receta y Escandallo -->
                        <VBox spacing="12.0" styleClass="surface-card" GridPane.columnIndex="1">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                    <children>
                                        <Label styleClass="text-h2" text="2. Insumos de la Receta (Escandallo)" />
                                        <Region HBox.hgrow="ALWAYS" />
                                        <Label fx:id="lblResumenEscandallo" styleClass="badge-pill-success" text="Costo Receta: S/ 5.70 · Margen: 69.2%" />
                                    </children>
                                </HBox>

                                <!-- Barra para agregar insumo a la receta -->
                                <HBox alignment="BOTTOM_LEFT" spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Insumo de Almacén" />
                                                <ComboBox fx:id="cmbInsumoReceta" maxWidth="1.7976931348623157E308" />
                                            </children>
                                        </VBox>
                                        <VBox prefWidth="140.0" spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Cantidad Requerida" />
                                                <TextField fx:id="txtCantidadReceta" promptText="Ej. 150 o 1" styleClass="input-field" text="150" />
                                            </children>
                                        </VBox>
                                        <Button fx:id="btnAgregarInsumo" mnemonicParsing="false" onAction="#handleAgregarInsumoReceta" styleClass="btn-primary" text="+ Agregar" />
                                        <Button fx:id="btnQuitarInsumo" mnemonicParsing="false" onAction="#handleEliminarInsumoReceta" styleClass="btn-secondary" text="Quitar" />
                                    </children>
                                </HBox>

                                <!-- Tabla de componentes de la receta formateados con UnidadMedidaFormatter -->
                                <TableView fx:id="tblComponentesReceta" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colRecInsumo" prefWidth="260.0" text="Insumo Asociado" />
                                        <TableColumn fx:id="colRecCantidad" prefWidth="165.0" text="Cantidad por Porción" />
                                        <TableColumn fx:id="colRecUnidad" prefWidth="115.0" text="Unidad" />
                                    </columns>
                                </TableView>
                            </children>
                        </VBox>

                    </children>
                </GridPane>
            </center>

        </BorderPane>
    </children>
</StackPane>
