<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootAvanzadosStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ReportesAvanzadosController">
    <children>
        <ScrollPane fitToWidth="true" fitToHeight="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <BorderPane minWidth="960.0">
            <!-- Cabecera -->
            <top>
                <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Reportes Avanzados y Business Intelligence" />
                                                <Label styleClass="badge-pill-accent" text="FINANZAS v2.0" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Analítica multidimensional de operaciones con exportación universal (PDF, Excel, CSV)" />
                                    </children>
                                </VBox>
                                <HBox alignment="CENTER_RIGHT" spacing="8.0">
                                    <children>
                                        <Button fx:id="btnExportarPdf" mnemonicParsing="false" onAction="#handleExportarPdf" styleClass="btn-primary" text="Exportar a PDF" />
                                        <Button fx:id="btnExportarExcel" mnemonicParsing="false" onAction="#handleExportarExcel" styleClass="btn-secondary" text="Exportar a Excel (.xlsx)" />
                                        <Button fx:id="btnExportarCsv" mnemonicParsing="false" onAction="#handleExportarCsv" styleClass="btn-secondary" text="Exportar a CSV" />
                                    </children>
                                </HBox>
                            </children>
                        </HBox>

                        <!-- Filtros del Reporte -->
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label minWidth="-Infinity" styleClass="text-body-strong" text="Categoría:" />
                                <ComboBox fx:id="cbCategoriaReporte" prefWidth="265.0" styleClass="form-combo-box" />
                                <Label minWidth="-Infinity" styleClass="text-body-strong" text="Desde:" />
                                <DatePicker fx:id="dpInicio" minWidth="142.0" prefWidth="142.0" styleClass="form-date-picker" />
                                <Label minWidth="-Infinity" styleClass="text-body-strong" text="Hasta:" />
                                <DatePicker fx:id="dpFin" minWidth="142.0" prefWidth="142.0" styleClass="form-date-picker" />
                                <Button fx:id="btnConsultar" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleConsultarReporte" styleClass="btn-secondary" text="Generar Análisis" />
                                <Region HBox.hgrow="ALWAYS" />
                            </children>
                        </HBox>

                        <!-- Accesos Rápidos BI v4.9.0 -->
                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                            <children>
                                <Label minWidth="-Infinity" styleClass="text-body-caption" text="Vistas BI:" />
                                <Button fx:id="btnModoAnalitica" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleModoAnalitica" styleClass="btn-primary" text="Analítica General" />
                                <Button fx:id="btnModoMargenes" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleModoMargenes" styleClass="btn-secondary" text="Márgenes por Categoría" />
                                <Button fx:id="btnModoCohortes" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleModoCohortes" styleClass="btn-secondary" text="Cohortes y Retención" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblEstadoReporte" styleClass="text-body-caption" text="Listo" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Centro: Comparativas, KPIs, Gráfico/Tabla o Cohortes -->
            <center>
                <VBox spacing="12.0" styleClass="view-content" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Comparativas Automáticas de Períodos (v4.9.0 Fase 2.1) — usa surface-card para preservar las 3 kpi-card-secondary -->
                        <HBox fx:id="panelComparativasReportes" spacing="14.0">
                            <children>
                                <VBox spacing="4.0" styleClass="surface-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="text-overline" text="VENTAS DE HOY VS. AYER" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblRepHoyVsAyerBadge" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="BASELINE_LEFT" spacing="10.0">
                                            <children>
                                                <Label fx:id="lblRepHoyVsAyerValor" styleClass="kpi-value-24-blue" text="S/ 0.00" />
                                                <Label fx:id="lblRepHoyVsAyerSub" styleClass="kpi-subtitle-muted" text="Ayer: S/ 0.00" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <VBox spacing="4.0" styleClass="surface-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="8.0">
                                            <children>
                                                <Label styleClass="text-overline" text="VENTAS DE ESTE MES VS. MES ANTERIOR" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <Label fx:id="lblRepMesVsAntBadge" styleClass="badge-pill-neutral" text="→ 0.0%" />
                                            </children>
                                        </HBox>
                                        <HBox alignment="BASELINE_LEFT" spacing="10.0">
                                            <children>
                                                <Label fx:id="lblRepMesVsAntValor" styleClass="kpi-value-24-success" text="S/ 0.00" />
                                                <Label fx:id="lblRepMesVsAntSub" styleClass="kpi-subtitle-muted" text="Mes anterior: S/ 0.00" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Tarjetas de KPIs del Reporte Activo (v4.6.0 Fase 3) -->
                        <HBox spacing="14.0">
                            <children>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="MONTO TOTAL DE LA MUESTRA" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-accent">
                                                    <children>
                                                        <FontIcon iconColor="#F05A22" iconLiteral="fas-coins" iconSize="16" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiMontoTotal" styleClass="kpi-value-24-accent" text="S/ 0.00" />
                                        <Label fx:id="lblKpiSubTotal" styleClass="kpi-subtitle-muted" text="0 registros analizados" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="PROMEDIO POR TRANSACCIÓN" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-blue">
                                                    <children>
                                                        <FontIcon iconColor="#2563EB" iconLiteral="fas-chart-line" iconSize="16" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiPromedio" styleClass="kpi-value-24-blue" text="S/ 0.00" />
                                        <Label styleClass="kpi-subtitle-muted" text="Ticket o costo promedio" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0" styleClass="kpi-card-secondary" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT">
                                            <children>
                                                <Label styleClass="text-overline" text="MAYOR APORTE AL VOLUMEN" />
                                                <Region HBox.hgrow="ALWAYS" />
                                                <StackPane styleClass="kpi-icon-circle-success">
                                                    <children>
                                                        <FontIcon iconColor="#059669" iconLiteral="fas-trophy" iconSize="16" />
                                                    </children>
                                                </StackPane>
                                            </children>
                                        </HBox>
                                        <Label fx:id="lblKpiTopItem" styleClass="kpi-value-24" text="-" />
                                        <Label fx:id="lblKpiTopValor" styleClass="kpi-subtitle-muted" text="S/ 0.00 facturado" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>

                        <!-- Panel de Cohortes y Retención de Clientes (v4.9.0 Fase 3.1) -->
                        <VBox fx:id="panelCohortes" managed="false" spacing="10.0" visible="false" VBox.vgrow="ALWAYS">
                            <children>
                                <Label fx:id="lblCohortesAviso" managed="false" styleClass="badge-pill-warning" visible="false" wrapText="true" />
                                <HBox spacing="14.0" VBox.vgrow="ALWAYS">
                                    <children>
                                        <VBox prefWidth="445.0" spacing="6.0" styleClass="surface-card">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="8.0">
                                                    <children>
                                                        <Label styleClass="text-h3" text="Resumen de Fidelización" />
                                                        <Region HBox.hgrow="ALWAYS" />
                                                        <Label styleClass="badge-pill-neutral" text="Corte Mensual" />
                                                    </children>
                                                </HBox>
                                                <TableView fx:id="tblResumenCohortes" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colSegNombre" prefWidth="245.0" text="Segmento" />
                                                        <TableColumn fx:id="colSegCantidad" prefWidth="85.0" text="Cant." />
                                                        <TableColumn fx:id="colSegPorcentaje" prefWidth="80.0" text="Part. %" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0" styleClass="surface-card" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="text-h3" text="Matriz de Cohortes Mensuales (% Retención)" />
                                                <TableView fx:id="tblMatrizCohortes" prefHeight="250.0" VBox.vgrow="ALWAYS">
                                                    <columns>
                                                        <TableColumn fx:id="colCohorteMes" prefWidth="130.0" text="Cohorte" />
                                                        <TableColumn fx:id="colCohorteTamano" prefWidth="70.0" text="Tamaño" />
                                                        <TableColumn fx:id="colCohorteM1" prefWidth="80.0" text="Mes 1" />
                                                        <TableColumn fx:id="colCohorteM2" prefWidth="80.0" text="Mes 2" />
                                                        <TableColumn fx:id="colCohorteM3" prefWidth="80.0" text="Mes 3" />
                                                        <TableColumn fx:id="colCohorteM4" prefWidth="80.0" text="Mes 4" />
                                                    </columns>
                                                    <columnResizePolicy>
                                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                                    </columnResizePolicy>
                                                </TableView>
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>
                            </children>
                        </VBox>

                        <HBox fx:id="panelTablaGrafico" spacing="14.0" VBox.vgrow="ALWAYS">
                            <children>
                                <!-- Tabla de Resultados -->
                                <VBox spacing="8.0" styleClass="surface-card" HBox.hgrow="ALWAYS">
                                    <children>
                                        <Label fx:id="lblTituloTabla" styleClass="text-h3" text="Resultados Detallados" />
                                        <TableView fx:id="tblReporte" VBox.vgrow="ALWAYS">
                                            <columns>
                                                <TableColumn fx:id="col1" prefWidth="220.0" text="Concepto / Entidad" />
                                                <TableColumn fx:id="col2" prefWidth="130.0" text="Volumen / Qty" />
                                                <TableColumn fx:id="col3" prefWidth="140.0" text="Subtotal" />
                                                <TableColumn fx:id="col4" prefWidth="140.0" text="Total S/" />
                                                <TableColumn fx:id="col5" prefWidth="110.0" text="Participación %" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>

                                <!-- Gráfico de Distribución (Donut / PieChart Moderno) -->
                                <VBox prefWidth="420.0" spacing="8.0" styleClass="surface-card">
                                    <children>
                                        <Label styleClass="text-h3" text="Distribución Gráfica" />
                                        <PieChart fx:id="pieChartDistribucion" animated="false" labelsVisible="false" legendSide="BOTTOM" VBox.vgrow="ALWAYS" />
                                    </children>
                                </VBox>
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
