<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox prefHeight="720.0" prefWidth="1120.0" spacing="20.0" styleClass="pos-catalog-panel" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.KardexController">

    <!-- Topbar y Filtros Superiores (§10) -->
    <VBox spacing="16.0" styleClass="surface-card">
        <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <children>
                    <VBox spacing="2.0">
                        <children>
                            <HBox alignment="CENTER_LEFT" spacing="10.0">
                                <children>
                                    <Label styleClass="view-heading" text="Kardex Valorizado e Inventario de Insumos" />
                                    <Label styleClass="badge-pill-accent" text="TRAZABILIDAD PEPS" />
                                </children>
                            </HBox>
                            <Label styleClass="view-subheading" text="Auditoría de entradas, salidas por venta, mermas y saldos de almacén" />
                        </children>
                    </VBox>
                    <Region HBox.hgrow="ALWAYS" />
                    <Label fx:id="lblResumenKardex" styleClass="text-caption" text="Movimientos auditados" />
                </children>
            </HBox>

            <Region styleClass="divider-horizontal" />

            <!-- Filtros superiores: insumo, fecha desde, fecha hasta, botón Filtrar naranja (§10) -->
            <HBox alignment="BOTTOM_LEFT" spacing="14.0">
                <children>
                    <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                        <children>
                            <Label styleClass="text-body-strong" text="Insumo" />
                            <ComboBox fx:id="cmbInsumo" maxWidth="1.7976931348623157E308" promptText="Todos los insumos" />
                        </children>
                    </VBox>

                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="text-body-strong" text="Fecha desde" />
                            <DatePicker fx:id="dpFechaDesde" prefWidth="185.0" promptText="DD/MM/AAAA" />
                        </children>
                    </VBox>

                    <VBox spacing="6.0">
                        <children>
                            <Label styleClass="text-body-strong" text="Fecha hasta" />
                            <DatePicker fx:id="dpFechaHasta" prefWidth="185.0" promptText="DD/MM/AAAA" />
                        </children>
                    </VBox>

                    <Button fx:id="btnFiltrar" mnemonicParsing="false" onAction="#handleFiltrar" styleClass="btn-primary" text="Filtrar" />
                    <Button fx:id="btnExportarPdf" mnemonicParsing="false" onAction="#handleExportarPdf" styleClass="btn-secondary" text="Exportar PDF" />
                    <Button fx:id="btnExportarExcel" mnemonicParsing="false" onAction="#handleExportarExcel" styleClass="btn-secondary" text="Exportar Excel" />
                    <Button fx:id="btnExportarCsv" mnemonicParsing="false" onAction="#handleExportarCsv" styleClass="btn-secondary" text="Exportar CSV" />
                </children>
            </HBox>
        </children>
    </VBox>

    <!-- TableView con filas alternas, sin bordes verticales, solo horizontales (§10) -->
    <TableView fx:id="tblKardex" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colFecha" prefWidth="175.0" text="Fecha" />
            <TableColumn fx:id="colTipo" prefWidth="150.0" text="Tipo" />
            <TableColumn fx:id="colInsumo" prefWidth="245.0" text="Insumo" />
            <TableColumn fx:id="colCantidad" prefWidth="145.0" text="Cantidad" />
            <TableColumn fx:id="colSaldo" prefWidth="155.0" text="Saldo" />
            <TableColumn fx:id="colUsuario" prefWidth="175.0" text="Usuario" />
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
        </columnResizePolicy>
    </TableView>

</VBox>
