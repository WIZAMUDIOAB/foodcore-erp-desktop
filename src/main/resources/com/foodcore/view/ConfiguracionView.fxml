<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootConfigStack" prefHeight="720.0" prefWidth="1120.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.ConfiguracionController">
    <children>
        <ScrollPane fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="AS_NEEDED">
            <content>
                <StackPane styleClass="pos-catalog-panel">
                    <children>
                        <VBox alignment="TOP_CENTER" maxWidth="780.0" prefWidth="780.0" spacing="18.0" styleClass="caja-centered-column">
                            <children>
                                <VBox spacing="4.0" styleClass="surface-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Configuración del Restaurante e Impresoras" />
                                                <Label styleClass="badge-pill-neutral" text="TICKET Y MÚLTIPLES IMPRESORAS" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Datos de cabecera del comprobante y ruteo simultáneo de comandas KDS por categoría hacia impresoras de Windows" />
                                    </children>
                                </VBox>

                                <VBox spacing="14.0" styleClass="surface-card">
                                    <children>
                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Nombre Comercial del Restaurante" />
                                                <TextField fx:id="txtNombreRestaurante" styleClass="input-field" text="FoodCore Fast Food S.A.C." />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Dirección del Local" />
                                                <TextField fx:id="txtDireccion" styleClass="input-field" text="Av. Javier Prado Este 2450, San Borja, Lima" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Teléfono de Contacto" />
                                                <TextField fx:id="txtTelefono" styleClass="input-field" text="(01) 442-8900" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="RUC Opcional (Referencia en Comprobante Interno)" />
                                                <TextField fx:id="txtRuc" styleClass="input-field" text="20609874512" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="4.0">
                                            <children>
                                                <Label styleClass="text-body-strong" text="Impresora Térmica Principal (Comprobantes POS)" />
                                                <TextField fx:id="txtImpresora" styleClass="input-field" text="EPSON-TM-T20III" />
                                            </children>
                                        </VBox>

                                        <HBox alignment="CENTER_RIGHT">
                                            <children>
                                                <Button fx:id="btnGuardarConfig" mnemonicParsing="false" onAction="#handleGuardarConfiguracion" styleClass="btn-primary" text="Guardar Configuración" />
                                            </children>
                                        </HBox>
                                    </children>
                                </VBox>

                                <!-- Múltiples Impresoras por Categoría (v5.2.0 Ítem 1) -->
                                <VBox spacing="12.0" styleClass="surface-card">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="text-h2" text="Ruteo de Comandas por Categoría (Múltiples Impresoras)" />
                                                <Label styleClass="badge-pill-accent" text="COCINA / BARRA" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="text-caption" text="Asigne cada categoría de platillos a una impresora de Windows o cola de impresión diferente. Al enviar comanda se imprimirán en paralelo." />

                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <ComboBox fx:id="cmbCategoriaImpresora" prefWidth="195.0" promptText="Categoría de menú" />
                                                <ComboBox fx:id="cmbNombreImpresoraWindows" editable="true" prefWidth="215.0" promptText="Impresora Windows (ej. Cocina, Barra)" HBox.hgrow="ALWAYS" />
                                                <Button fx:id="btnAsignarImpresora" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleAsignarImpresoraCategoria" styleClass="btn-primary" text="Asignar Impresora" />
                                                <Button fx:id="btnQuitarImpresora" minWidth="-Infinity" mnemonicParsing="false" onAction="#handleEliminarImpresoraCategoria" styleClass="btn-secondary" text="Quitar" />
                                            </children>
                                        </HBox>

                                        <TableView fx:id="tblRuteoImpresoras" prefHeight="190.0">
                                            <columns>
                                                <TableColumn fx:id="colCatNombre" prefWidth="240.0" text="Categoría de Producto" />
                                                <TableColumn fx:id="colImpWindows" prefWidth="360.0" text="Impresora Windows Destino" />
                                                <TableColumn fx:id="colImpEstado" prefWidth="130.0" text="Estado" />
                                            </columns>
                                            <columnResizePolicy>
                                                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                            </columnResizePolicy>
                                        </TableView>
                                    </children>
                                </VBox>
                            </children>
                        </VBox>
                    </children>
                </StackPane>
            </content>
        </ScrollPane>
    </children>
</StackPane>
