<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<ScrollPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.foodcore.controller.ReportesController"
            fitToWidth="true" style="-fx-background-color: -color-bg-base;">

    <VBox spacing="18.0" style="-fx-padding: 24px; -fx-background-color: -color-bg-base;">

        <!-- Header y Filtros -->
        <HBox alignment="CENTER_LEFT" spacing="16.0">
            <VBox spacing="2.0">
                <Label text="Analítica y Rendimiento" styleClass="view-heading"/>
                <Label text="Métricas comerciales, rotación de carta e ingresos por canal de cobro" styleClass="view-subheading"/>
            </VBox>
            <Region HBox.hgrow="ALWAYS"/>
            <Label text="Periodo:" style="-fx-font-weight: 700; -fx-text-fill: -color-ink-primary; -fx-font-size: 12px;"/>
            <ComboBox fx:id="cmbPeriodo" prefWidth="180.0" prefHeight="36.0"
                      style="-fx-font-size: 13px; -fx-background-radius: 7px; -fx-border-color: -color-border-subtle; -fx-border-radius: 7px;"/>
            <Button text="⟳ Actualizar" onAction="#cargarDatos" prefHeight="36.0" styleClass="btn-secondary"/>
        </HBox>

        <Separator style="-fx-opacity: 0.6;"/>

        <!-- Tarjetas KPI (Proximity & High Contrast Values) -->
        <HBox spacing="14.0">
            <!-- KPI 1: Total Ventas -->
            <VBox HBox.hgrow="ALWAYS" spacing="4.0" styleClass="surface-card" style="-fx-padding: 16px;">
                <Label text="FACTURACIÓN TOTAL" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: -color-ink-muted; -fx-letter-spacing: 0.06em;"/>
                <Label fx:id="lblTotalVentas" text="S/ 0.00" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -color-brand-ember;"/>
                <Label text="Ingresos brutos cerrados" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
            </VBox>

            <!-- KPI 2: Cantidad Transacciones -->
            <VBox HBox.hgrow="ALWAYS" spacing="4.0" styleClass="surface-card" style="-fx-padding: 16px;">
                <Label text="VENTAS REALIZADAS" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: -color-ink-muted; -fx-letter-spacing: 0.06em;"/>
                <Label fx:id="lblCantidadVentas" text="0" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -color-ink-primary;"/>
                <Label text="Comandas cobradas en caja" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
            </VBox>

            <!-- KPI 3: Ticket Promedio -->
            <VBox HBox.hgrow="ALWAYS" spacing="4.0" styleClass="surface-card" style="-fx-padding: 16px;">
                <Label text="TICKET PROMEDIO" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: -color-ink-muted; -fx-letter-spacing: 0.06em;"/>
                <Label fx:id="lblTicketPromedio" text="S/ 0.00" style="-fx-font-size: 24px; -fx-font-weight: 800; -fx-text-fill: -color-accent-emerald;"/>
                <Label text="Gasto promedio por mesa" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
            </VBox>

            <!-- KPI 4: Plato Mas Vendido -->
            <VBox HBox.hgrow="ALWAYS" spacing="4.0" styleClass="surface-card" style="-fx-padding: 16px;">
                <Label text="PLATO ESTRELLA" style="-fx-font-size: 10px; -fx-font-weight: 800; -fx-text-fill: -color-ink-muted; -fx-letter-spacing: 0.06em;"/>
                <Label fx:id="lblPlatoEstrella" text="Sin ventas" wrapText="true" style="-fx-font-size: 16px; -fx-font-weight: 800; -fx-text-fill: -color-ink-primary;"/>
                <Label fx:id="lblPlatoEstrellaQty" text="0 unidades vendidas" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
            </VBox>
        </HBox>

        <!-- Graficos Principales -->
        <HBox spacing="16.0" prefHeight="430.0">
            <!-- Grafico de Barras: Ventas por Dia -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="560.0" styleClass="surface-card" style="-fx-padding: 18px;">
                <Label text="Evolución de Ventas por Fecha" style="-fx-font-weight: 800; -fx-font-size: 14px; -fx-text-fill: -color-ink-primary;"/>
                <BarChart fx:id="barChartVentas" legendVisible="false" VBox.vgrow="ALWAYS">
                    <xAxis>
                        <CategoryAxis label="Fecha"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Monto Total (S/)"/>
                    </yAxis>
                </BarChart>
            </VBox>

            <!-- Grafico Circular con Selector de Tab: Baja Rotacion o Metodos de Pago -->
            <VBox spacing="10.0" HBox.hgrow="ALWAYS" prefWidth="440.0" styleClass="surface-card" style="-fx-padding: 18px;">
                <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                    <Tab text="Baja Rotación">
                        <VBox spacing="6.0" style="-fx-padding: 10px 0 0 0;">
                            <Label text="Platos con menor volumen de venta en el periodo" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
                            <PieChart fx:id="pieChartBajaRotacion" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>
                    <Tab text="Canales de Pago">
                        <VBox spacing="6.0" style="-fx-padding: 10px 0 0 0;">
                            <Label text="Distribución de facturación según método" style="-fx-font-size: 11px; -fx-text-fill: -color-ink-secondary;"/>
                            <PieChart fx:id="pieChartMetodosPago" VBox.vgrow="ALWAYS"/>
                        </VBox>
                    </Tab>
                </TabPane>
            </VBox>
        </HBox>

    </VBox>
</ScrollPane>
