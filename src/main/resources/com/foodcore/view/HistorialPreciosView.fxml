<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane fx:id="rootHistorialStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.HistorialPreciosController">
    <children>
        <BorderPane>
            <!-- Cabecera -->
            <top>
                <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Historial de Precios y Auditoría de Tarifas" />
                                                <Label styleClass="badge-pill-accent" text="FINANZAS v2.0" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Bitácora inmutable de cambios en precios de venta y costos de insumos con motivo auditado" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnNuevoCambio" mnemonicParsing="false" onAction="#handleAbrirModalAjuste" styleClass="btn-primary" text="+ Ajustar Precio" />
                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#cargarHistorialAsync" styleClass="btn-secondary" text="Actualizar" />
                            </children>
                        </HBox>

                        <HBox alignment="BOTTOM_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Filtrar por Tipo" />
                                        <ComboBox fx:id="cbFiltroTipo" prefWidth="150.0" styleClass="form-combo-box" />
                                    </children>
                                </VBox>
                                <VBox spacing="6.0">
                                    <children>
                                        <Label styleClass="label-form" text="Buscar ítem" />
                                        <TextField fx:id="txtBuscar" prefWidth="280.0" promptText="Buscar producto o insumo..." styleClass="form-text-field" />
                                    </children>
                                </VBox>
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalRegistros" styleClass="badge-pill-success" text="0 Modificaciones" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Centro: Tabla de Historial -->
            <center>
                <VBox spacing="12.0" styleClass="view-content" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Banner Informativo Regla Financiera §4.2 -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="badge-pill-accent" text="CONTROL INFLACIONARIO §4.2" />
                                <Label styleClass="text-body" text="Variaciones en compras de insumos superiores al +10% son auditadas automáticamente para protección del margen de receta." />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="stat-card" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tblHistorial" VBox.vgrow="ALWAYS">
                                    <placeholder>
                                        <VBox alignment="CENTER" spacing="12.0">
                                            <children>
                                                <FontIcon iconLiteral="fth-inbox" iconSize="48" styleClass="text-muted" />
                                                <Label styleClass="h3" text="No hay registros" />
                                                <Label styleClass="text-secondary" text="No se encontraron datos para el período seleccionado." />
                                            </children>
                                        </VBox>
                                    </placeholder>
                                    <columns>
                                        <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha / Hora" />
                                        <TableColumn fx:id="colTipo" prefWidth="95.0" text="Tipo" />
                                        <TableColumn fx:id="colEntidad" prefWidth="230.0" text="Producto / Insumo" />
                                        <TableColumn fx:id="colPrecioAnt" prefWidth="105.0" text="Precio Anterior" />
                                        <TableColumn fx:id="colPrecioNuevo" prefWidth="105.0" text="Precio Nuevo" />
                                        <TableColumn fx:id="colVariacion" prefWidth="95.0" text="Var. %" />
                                        <TableColumn fx:id="colUsuario" prefWidth="105.0" text="Usuario" />
                                        <TableColumn fx:id="colMotivo" prefWidth="250.0" text="Motivo Obligatorio" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>

        <!-- Modal Registrar Cambio de Precio -->
        <VBox fx:id="modalAjuste" alignment="CENTER" styleClass="modal-backdrop" visible="false">
            <children>
                <VBox maxHeight="680.0" maxWidth="500.0" prefWidth="500.0" spacing="0.0" styleClass="card, modal-card">
                    <children>
                        <!-- HEADER -->
                        <VBox spacing="4.0" styleClass="modal-header">
                            <padding><Insets top="24.0" right="24.0" bottom="16.0" left="24.0" /></padding>
                            <children>
                                <Label styleClass="h2" text="Ajustar Precio con Auditoría Obligatoria" />
                                <Label styleClass="text-secondary" text="Registre el nuevo valor y el sustento auditado del cambio" />
                            </children>
                        </VBox>

                        <!-- BODY -->
                        <ScrollPane fitToWidth="true" styleClass="edge-to-edge" VBox.vgrow="ALWAYS">
                            <content>
                                <VBox spacing="16.0" styleClass="modal-body">
                                    <padding><Insets top="0.0" right="24.0" bottom="24.0" left="24.0" /></padding>
                                    <children>
                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="label-form" text="Tipo de Entidad" />
                                                <ComboBox fx:id="cbModalTipo" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />
                                            </children>
                                        </VBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="label-form" text="Nombre del Ítem / Código" />
                                                <TextField fx:id="txtModalItemNombre" promptText="Hamburguesa Clásica / Carne de Res" styleClass="input-field" />
                                            </children>
                                        </VBox>

                                        <HBox spacing="16.0">
                                            <children>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Precio Anterior (S/)" />
                                                        <TextField fx:id="txtModalPrecioAnt" promptText="18.00" styleClass="input-field" />
                                                    </children>
                                                </VBox>
                                                <VBox spacing="8.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label styleClass="label-form" text="Nuevo Precio (S/)" />
                                                        <TextField fx:id="txtModalPrecioNuevo" promptText="20.00" styleClass="input-field" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </HBox>

                                        <VBox spacing="8.0">
                                            <children>
                                                <Label styleClass="label-form" text="Motivo Justificativo (Obligatorio, mín. 5 caracteres)" />
                                                <TextField fx:id="txtModalMotivo" promptText="Alza de costos mayoristas de insumo base" styleClass="input-field" />
                                            </children>
                                        </VBox>

                                        <Label fx:id="lblModalAjusteError" styleClass="text-danger" text="" wrapText="true" />
                                    </children>
                                </VBox>
                            </content>
                        </ScrollPane>

                        <!-- FOOTER -->
                        <HBox alignment="CENTER_RIGHT" spacing="12.0" styleClass="modal-footer">
                            <padding><Insets top="16.0" right="24.0" bottom="24.0" left="24.0" /></padding>
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCerrarModalAjuste" styleClass="btn-secondary" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardarAjuste" styleClass="btn-primary" text="Confirmar Cambio Auditado" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
