<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootHistorialStack" prefHeight="768.0" prefWidth="1080.0" styleClass="app-canvas" stylesheets="@../../../css/foodcore.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.foodcore.controller.HistorialPreciosController">
    <children>
        <BorderPane>
            <!-- Cabecera -->
            <top>
                <VBox spacing="16.0" styleClass="view-topbar" BorderPane.alignment="CENTER">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                                            <children>
                                                <Label styleClass="view-heading" text="Historial de Precios y Auditoría de Tarifas" />
                                                <Label styleClass="badge-pill-accent" text="FINANZAS v2.0" />
                                            </children>
                                        </HBox>
                                        <Label styleClass="view-subheading" text="Bitácora inmutable de cambios en precios de venta y costos de insumos con motivo auditado" />
                                    </children>
                                </VBox>
                                <Button fx:id="btnNuevoCambio" mnemonicParsing="false" onAction="#handleAbrirModalAjuste" styleClass="btn-primary" text="+ Ajustar Precio" />
                                <Button fx:id="btnActualizar" mnemonicParsing="false" onAction="#cargarHistorialSincrono" styleClass="btn-secondary" text="Actualizar" />
                            </children>
                        </HBox>

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <children>
                                <Label styleClass="text-body-strong" text="Filtrar por Tipo:" />
                                <ComboBox fx:id="cbFiltroTipo" prefWidth="150.0" styleClass="form-combo-box" />
                                <TextField fx:id="txtBuscar" prefWidth="280.0" promptText="Buscar producto o insumo..." styleClass="form-text-field" />
                                <Region HBox.hgrow="ALWAYS" />
                                <Label fx:id="lblTotalRegistros" styleClass="badge-pill-success" text="0 Modificaciones" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </top>

            <!-- Centro: Tabla de Historial -->
            <center>
                <VBox spacing="12.0" styleClass="view-content" BorderPane.alignment="CENTER">
                    <children>
                        <!-- Banner Informativo Regla Financiera §4.2 -->
                        <HBox alignment="CENTER_LEFT" spacing="12.0" styleClass="stat-card">
                            <children>
                                <Label styleClass="badge-pill-accent" text="CONTROL INFLACIONARIO §4.2" />
                                <Label styleClass="text-body" text="Variaciones en compras de insumos superiores al +10% son auditadas automáticamente para protección del margen de receta." />
                            </children>
                        </HBox>

                        <VBox spacing="8.0" styleClass="stat-card" VBox.vgrow="ALWAYS">
                            <children>
                                <TableView fx:id="tblHistorial" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colFecha" prefWidth="130.0" text="Fecha / Hora" />
                                        <TableColumn fx:id="colTipo" prefWidth="95.0" text="Tipo" />
                                        <TableColumn fx:id="colEntidad" prefWidth="230.0" text="Producto / Insumo" />
                                        <TableColumn fx:id="colPrecioAnt" prefWidth="105.0" text="Precio Anterior" />
                                        <TableColumn fx:id="colPrecioNuevo" prefWidth="105.0" text="Precio Nuevo" />
                                        <TableColumn fx:id="colVariacion" prefWidth="95.0" text="Var. %" />
                                        <TableColumn fx:id="colUsuario" prefWidth="105.0" text="Usuario" />
                                        <TableColumn fx:id="colMotivo" prefWidth="250.0" text="Motivo Obligatorio" />
                                    </columns>
                                    <columnResizePolicy>
                                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                                    </columnResizePolicy>
                                </TableView>
                            </children>
                        </VBox>
                    </children>
                </VBox>
            </center>
        </BorderPane>

        <!-- Modal Registrar Cambio de Precio -->
        <VBox fx:id="modalAjuste" alignment="CENTER" styleClass="modal-backdrop" visible="false">
            <children>
                <VBox maxWidth="460.0" spacing="16.0" styleClass="modal-card">
                    <children>
                        <Label styleClass="modal-title" text="Ajustar Precio con Auditoría Obligatoria" />
                        <VBox spacing="10.0">
                            <children>
                                <Label styleClass="form-field-label" text="Tipo de Entidad:" />
                                <ComboBox fx:id="cbModalTipo" maxWidth="1.7976931348623157E308" styleClass="form-combo-box" />

                                <Label styleClass="form-field-label" text="Nombre del Ítem / Código:" />
                                <TextField fx:id="txtModalItemNombre" promptText="Hamburguesa Clásica / Carne de Res" styleClass="form-text-field" />

                                <HBox spacing="10.0">
                                    <children>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Precio Anterior (S/):" />
                                                <TextField fx:id="txtModalPrecioAnt" promptText="18.00" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                            <children>
                                                <Label styleClass="form-field-label" text="Nuevo Precio (S/):" />
                                                <TextField fx:id="txtModalPrecioNuevo" promptText="20.00" styleClass="form-text-field" />
                                            </children>
                                        </VBox>
                                    </children>
                                </HBox>

                                <Label styleClass="form-field-label" text="Motivo Justificativo (Obligatorio, mín. 5 caracteres):" />
                                <TextField fx:id="txtModalMotivo" promptText="Alza de costos mayoristas de insumo base" styleClass="form-text-field" />
                            </children>
                        </VBox>

                        <Label fx:id="lblModalAjusteError" styleClass="text-danger" text="" wrapText="true" />

                        <HBox alignment="CENTER_RIGHT" spacing="10.0">
                            <children>
                                <Button mnemonicParsing="false" onAction="#handleCerrarModalAjuste" styleClass="btn-secondary" text="Cancelar" />
                                <Button mnemonicParsing="false" onAction="#handleGuardarAjuste" styleClass="btn-primary" text="Confirmar Cambio Auditado" />
                            </children>
                        </HBox>
                    </children>
                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
