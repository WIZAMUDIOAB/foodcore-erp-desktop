<?xml version="1.0"?>
<!DOCTYPE module PUBLIC
    "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
    "https://checkstyle.org/dtds/configuration_1_3.dtd">

<module name="Checker">
    <property name="charset" value="UTF-8"/>
    <property name="severity" value="error"/>
    <property name="fileExtensions" value="java"/>

    <!-- Prohibir System.out.println y System.err.println (SPEC-FOODCORE-v1.0 §4.2, §18.1) -->
    <module name="RegexpSingleline">
        <property name="format" value="System\.(out|err)\.print"/>
        <property name="message" value="Prohibido usar System.out/System.err; utilice Logger."/>
    </module>

    <module name="TreeWalker">
        <!-- Prohibir marcadores TODO o FIXME pendientes en comentarios (REMEDIATION §4) -->
        <module name="TodoComment">
            <property name="format" value="(TODO:|FIXME:)"/>
        </module>
        <module name="PackageName">
            <property name="format" value="^com\.foodcore(\.[a-z][a-z0-9]*)*$"/>
        </module>
        <module name="OuterTypeFilename"/>
        <!-- Prohibir bloques catch vacíos silenciosos; cualquier catch debe loguear o documentar explícitamente -->
        <module name="EmptyCatchBlock"/>

        <!-- Higiene de imports -->
        <module name="UnusedImports"/>
        <module name="RedundantImport"/>
        <module name="AvoidStarImport"/>

        <!-- Consistencia estructural y prevención de errores -->
        <module name="NeedBraces"/>
        <module name="EqualsHashCode"/>
        <module name="SimplifyBooleanExpression"/>
        <module name="SimplifyBooleanReturn"/>
        <module name="OneStatementPerLine"/>
        <module name="UpperEll"/>
    </module>
</module>
