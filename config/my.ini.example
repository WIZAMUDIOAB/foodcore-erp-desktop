# ==============================================================================
# FoodCore ERP - Ejemplo de configuracion segura para MySQL 8.0
# Copiar a my.ini / /etc/mysql/mysql.conf.d/foodcore.cnf en el servidor anfitrion.
# Aislar el puerto 3306 exclusivamente a loopback local (127.0.0.1);
# en topologias LAN restringir por firewall y exigir TLS (require_secure_transport=ON).
# ==============================================================================
[mysqld]
port=3306
bind-address=127.0.0.1
character-set-server=utf8mb4
collation-server=utf8mb4_0900_ai_ci
default-time-zone=-05:00
innodb_lock_wait_timeout=10
transaction-isolation=REPEATABLE-READ
