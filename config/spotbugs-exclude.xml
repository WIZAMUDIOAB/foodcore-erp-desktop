<?xml version="1.0" encoding="UTF-8"?>
<!--
  Política AppSec de exclusiones SpotBugs — FoodCore ERP
  Las exclusiones de seguridad requieren revisión de AppSec.
  Ninguna regla de seguridad o higiene crítica (SQL_INJECTION, SQL_PREPARED_STATEMENT_GENERATED_FROM_NONCONSTANT_STRING,
  XSS, HARD_CODE_PASSWORD, PATH_TRAVERSAL, PREDICTABLE_RANDOM, WEAK_TRUST_MANAGER, OBL_UNSATISFIED_OBLIGATION,
  ODR_OPEN_DATABASE_RESOURCE, REC_CATCH_EXCEPTION, IS2_INCONSISTENT_SYNC, NP_*, RV_*, DM_EXIT)
  puede ser excluida aquí. Las exclusiones se limitan estrictamente a falsos positivos verificados.
-->
<FindBugsFilter>
    <!-- Justificación: Los controladores JavaFX inyectan controles @FXML, ObservableList enlazadas y subcontroladores que se exponen por diseño para FXML y pruebas UI; sin alcance sobre clases de seguridad/DAO. Revisor: AppSec (Equipo Ingeniería FoodCore) Fecha: 2026-11-10 -->
    <Match>
        <Package name="~com\.foodcore\.controller(\..*)?"/>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Justificación: Servicios de negocio y despachador Outbox reciben DAOs, TransactionManager y repositorios sin estado mediante inyección de dependencias en constructores (EI_EXPOSE_REP permanece activo en toda la capa service). Revisor: AppSec (PR-13 Hardening) Fecha: 2026-11-25 -->
    <Match>
        <And>
            <Or>
                <Package name="~com\.foodcore\.service(\..*)?"/>
                <Class name="com.foodcore.events.OutboxDispatcher"/>
            </Or>
            <Method name="&lt;init&gt;"/>
        </And>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>

    <!-- Justificación: Lista cerrada de 8 DTOs/records contenedores que transportan entidades de dominio JDBC mutables (Pedido, Venta, Caja, Usuario, Asistencia, Categoria) o JsonNode ObjectNode de protocolo HMAC (cuyo payload debe ser mutado in-place en tests de adulteración). Revisor: AppSec (PR-13 Hardening) Fecha: 2026-11-25 -->
    <Match>
        <Or>
            <Class name="com.foodcore.model.dto.EventoKdsDTO"/>
            <Class name="com.foodcore.model.dto.OfflineOrderPayloadDTO"/>
            <Class name="com.foodcore.service.AsistenciaService$ResultadoMarcaje"/>
            <Class name="com.foodcore.service.MenuGestionService$CategoriaResultado"/>
            <Class name="com.foodcore.service.api.ApiOperacionesPort$EstadoCajaSnapshot"/>
            <Class name="com.foodcore.service.api.ApiOperacionesPort$PedidoConDetalles"/>
            <Class name="com.foodcore.service.api.ApiOperacionesPort$ResultadoCobroCaja"/>
            <Class name="com.foodcore.service.api.ApiOperacionesPort$ResultadoCreacionPedido"/>
        </Or>
        <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
    </Match>

    <!-- Justificación: JavaFX expone el Stage principal único para asignar el owner de diálogos modales en el hilo UI. Revisor: AppSec (Equipo Ingeniería FoodCore) Fecha: 2026-11-10 -->
    <Match>
        <Class name="com.foodcore.App"/>
        <Method name="getPrimaryStage"/>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- Justificación: Singletons de infraestructura (SyncWorker, ServidorSockets, JsonMapperProvider) y el pool compartido Hikari DataSource deben retornar la instancia gestionada única por proceso. Revisor: AppSec (Equipo Ingeniería FoodCore) Fecha: 2026-11-22 -->
    <Match>
        <Or>
            <And>
                <Class name="com.foodcore.offline.SyncWorker"/>
                <Method name="getInstancia"/>
            </And>
            <And>
                <Class name="com.foodcore.util.ServidorSockets"/>
                <Method name="getInstance"/>
            </And>
            <And>
                <Class name="com.foodcore.util.JsonMapperProvider"/>
                <Method name="getMapper"/>
            </And>
            <And>
                <Class name="com.foodcore.util.ConexionBD"/>
                <Method name="getDataSource"/>
            </And>
        </Or>
        <Bug pattern="MS_EXPOSE_REP"/>
    </Match>

    <!-- Justificación FindSecBugs (Riesgo aceptado R1 / R-KDS-TLS-01 en docs/RISK_ACCEPTANCE.md): El canal TCP 9090 de KDS opera sin TLS en subred LAN cableada aislada con autenticación HELLO/AUTH_TERMINAL y firma HMAC-SHA256. Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.util.ServidorSockets"/>
        <Method name="~.*iniciar.*"/>
        <Bug pattern="UNENCRYPTED_SERVER_SOCKET"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo): Sonda TCP exclusivamente contra loopback (127.0.0.1) para verificar disponibilidad de puerto local sin intercambiar datos sensibles. Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.service.SistemaMonitorService"/>
        <Method name="puertoLocalAbierto"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo RFC 3207): Conexión TCP inicial SMTP en puerto 587 requerida por protocolo antes de negociar STARTTLS y actualizar a SSLSocket con validación de hostname HTTPS. Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.service.AlertaService"/>
        <Method name="abrirSocketSmtp"/>
        <Bug pattern="UNENCRYPTED_SOCKET"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo): Todos los campos dinámicos interpolados en construirMenuDigitalHtmlDinamico pasan previamente por escapeHtml() (&, <, >, "). Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.service.MenuQrService"/>
        <Method name="construirMenuDigitalHtmlDinamico"/>
        <Bug pattern="POTENTIAL_XML_INJECTION"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo): SqlQueryBuilder.buildInPlaceholders genera exclusivamente marcadores '?' separados por coma; los valores se vinculan vía PreparedStatement.setLong. Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.dao.impl.InsumoDAOImpl"/>
        <Method name="lockearPorIds"/>
        <Bug pattern="SQL_INJECTION_JDBC"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo): eliminarDocumento valida confinamiento con rutaDoc.startsWith(baseAbs) tras normalize(). Revisor: AppSec (PR-13 Hardening) Fecha: 2026-11-25 -->
    <Match>
        <Class name="com.foodcore.service.impl.ExpedienteEmpleadoServiceImpl"/>
        <Method name="eliminarDocumento"/>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>

    <!-- Justificación FindSecBugs (Falso positivo): Rutas de keystore y certificado X.509 provienen exclusivamente de variables de entorno de configuración de servidor del operador (FOODCORE_KEYSTORE_PATH / FOODCORE_CERT_PATH). Revisor: AppSec (Hardening v5.7.1) Fecha: 2026-11-18 -->
    <Match>
        <Class name="com.foodcore.api.ApiServer"/>
        <Or>
            <Method name="servirCertificadoSsl"/>
            <Method name="obtenerSslContextFactory"/>
        </Or>
        <Bug pattern="PATH_TRAVERSAL_IN"/>
    </Match>
</FindBugsFilter>
