# FoodCore ERP — Generación de Keystore HTTPS (Ejemplo / Producción LAN)
# Nunca subas archivos *.jks, *.p12 ni *.keystore al repositorio Git.
#
# 1. Generar un par de claves autofirmado (validez 3650 días) en el servidor:
#    Reemplaza <PASSWORD_SEGURO> por una contraseña fuerte (mínimo 8 caracteres)
#    y ajusta la IP SAN de tu servidor LAN si corresponde.
#
# keytool -genkeypair \
#   -alias foodcore \
#   -keyalg RSA \
#   -keysize 2048 \
#   -storetype PKCS12 \
#   -validity 3650 \
#   -keystore keystore.jks \
#   -storepass "<PASSWORD_SEGURO>" \
#   -keypass "<PASSWORD_SEGURO>" \
#   -dname "CN=FoodCore-ERP, OU=POS-LAN, O=FoodCore, L=Lima, C=PE" \
#   -ext "SAN=DNS:localhost,IP:127.0.0.1"
#
# 2. Exportar el certificado público para distribuirlo a tablets (/foodcore.cer):
#
# keytool -exportcert \
#   -alias foodcore \
#   -keystore keystore.jks \
#   -storepass "<PASSWORD_SEGURO>" \
#   -file foodcore.cer
#
# 3. Exportar variables de entorno obligatorias antes de iniciar FoodCore ERP:
#    Linux/macOS:
#      export FOODCORE_KEYSTORE_PASS="<PASSWORD_SEGURO>"
#      export FOODCORE_KEYSTORE_PATH="/ruta/segura/keystore.jks"
#      export FOODCORE_CERT_PATH="/ruta/segura/foodcore.cer"
#    Windows PowerShell:
#      $env:FOODCORE_KEYSTORE_PASS="<PASSWORD_SEGURO>"
#      $env:FOODCORE_KEYSTORE_PATH="C:\ruta\segura\keystore.jks"
#      $env:FOODCORE_CERT_PATH="C:\ruta\segura\foodcore.cer"
